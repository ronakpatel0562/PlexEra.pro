---
const clients = [
  { name: "Meta", category: "Social Technology" },
  { name: "Amazon Web Services", category: "Cloud Infrastructure" },
  { name: "Google", category: "Search & AI Systems" },
  { name: "Microsoft", category: "Enterprise Cloud" },
  { name: "Apple", category: "Hardware & Platforms" },
  { name: "Tesla", category: "Autonomous Systems" },
  { name: "OpenAI", category: "Generative AI Labs" },
  { name: "NVIDIA", category: "GPU Computing" },
  { name: "Salesforce", category: "Enterprise SaaS" },
  { name: "Oracle", category: "Cloud Database" }
];
---

<section class="py-12 bg-slate-100/70 border-y border-slate-200 overflow-hidden select-none">
  <div class="max-w-7xl mx-auto px-4 mb-6 text-center">
    <span class="text-xs font-bold uppercase tracking-widest text-slate-500">
      TRUSTED BY ENGINEERING LEADERS & OUR CANDIDATES ARE PLACED AT
    </span>
  </div>

  <div class="relative w-full flex overflow-x-hidden">
    <!-- Gradient Fade Edges -->
    <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-slate-100/90 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-slate-100/90 to-transparent z-10 pointer-events-none"></div>

    <div class="animate-marquee flex items-center gap-8 sm:gap-12">
      <!-- First Loop -->
      {clients.map((client) => (
        <div class="flex items-center gap-3 px-6 py-3 rounded-2xl bg-white border border-slate-200/90 shadow-xs shrink-0 hover:border-[#20C5CA] transition-colors">
          <div class="w-2.5 h-2.5 rounded-full bg-[#20C5CA]"></div>
          <div class="flex flex-col">
            <span class="font-bold text-sm text-[#041B3B]">{client.name}</span>
            <span class="text-[10px] text-slate-500 font-semibold">{client.category}</span>
          </div>
        </div>
      ))}
      <!-- Duplicate Loop for Infinite Scroll -->
      {clients.map((client) => (
        <div class="flex items-center gap-3 px-6 py-3 rounded-2xl bg-white border border-slate-200/90 shadow-xs shrink-0 hover:border-[#20C5CA] transition-colors">
          <div class="w-2.5 h-2.5 rounded-full bg-[#20C5CA]"></div>
          <div class="flex flex-col">
            <span class="font-bold text-sm text-[#041B3B]">{client.name}</span>
            <span class="text-[10px] text-slate-500 font-semibold">{client.category}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
