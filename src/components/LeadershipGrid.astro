---
import { Linkedin, Mail, ShieldCheck } from 'lucide-astro';

const leaders = [
  {
    name: "Vikram R. Patel",
    title: "Founder & CEO",
    specialty: "Strategy, Executive Sourcing & Global Operations",
    bio: "Ex-Engineering Director with 15+ years scaling cloud platforms and executive recruitment across US and APAC tech markets.",
    initials: "VP"
  },
  {
    name: "Sarah L. Jenkins",
    title: "Managing Director — Talent Sourcing",
    specialty: "Technical Screening & Partner Relations",
    bio: "Former Lead Tech Recruiter at Amazon. Specializes in principal engineer vetting and enterprise staff augmentation.",
    initials: "SJ"
  },
  {
    name: "Rohan Deshmukh",
    title: "Head of Career Advisory",
    specialty: "Candidate Acceleration & Negotiation Lead",
    bio: "Career Strategist with over 800+ executive placements. Pioneer of PlexEra's First-Year Technical Mentorship model.",
    initials: "RD"
  }
];
---

<section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center mb-16">
    <span class="text-xs font-extrabold uppercase tracking-widest text-[#19A4A8]">EXECUTIVE LEADERSHIP</span>
    <h2 class="text-3xl sm:text-5xl font-extrabold text-[#041B3B] mt-2">Guided by Industry Veterans</h2>
    <p class="text-slate-600 max-w-2xl mx-auto mt-3 text-base">Real experts dedicated to transparent, ethical, and high-performance talent alignment.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {leaders.map((leader) => (
      <div class="bg-white rounded-3xl p-7 border border-slate-200 shadow-sm hover:shadow-lg hover:border-slate-300 transition-all duration-300 flex flex-col justify-between group">
        <div>
          <!-- Avatar Placeholder with Initials & Badge -->
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-2xl bg-[#041B3B] p-0.5 shadow-md flex items-center justify-center font-extrabold text-lg text-white">
              <span class="text-[#20C5CA]">{leader.initials}</span>
            </div>
            <div>
              <h3 class="font-extrabold text-lg text-[#041B3B] group-hover:text-[#0284c7] transition-colors">{leader.name}</h3>
              <span class="text-xs font-bold text-[#19A4A8] block">{leader.title}</span>
            </div>
          </div>

          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-[11px] font-semibold text-slate-700 mb-4">
            <ShieldCheck class="w-3.5 h-3.5 text-[#19A4A8]" />
            <span>{leader.specialty}</span>
          </div>

          <p class="text-xs text-slate-600 leading-relaxed">
            {leader.bio}
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
          <span class="text-[11px] font-semibold text-slate-400">Verified Leader</span>
          <div class="flex items-center gap-2">
            <a href="https://linkedin.com" target="_blank" rel="noopener" class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-[#041B3B] transition-colors" aria-label="LinkedIn Profile">
              <Linkedin class="w-4 h-4" />
            </a>
            <a href="mailto:contact@plexera.com" class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-[#041B3B] transition-colors" aria-label="Email Leader">
              <Mail class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
