---
import { Phone, Mail, Globe, ArrowRight } from 'lucide-astro';
---

<div class="w-full bg-[#041B3B] border-b border-[#20C5CA]/20 py-2 px-4 text-xs text-slate-300 select-none">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-2">
    <!-- Announcement Banner Text -->
    <div class="flex items-center gap-2 text-center md:text-left">
      <span class="inline-block w-2 h-2 rounded-full bg-[#20C5CA] animate-ping"></span>
      <span class="font-medium text-slate-100">🚀 NEW: 2026 Tech Hiring & Compensation Strategy Report Published.</span>
      <a href="#report" class="text-[#20C5CA] hover:text-cyan-200 font-bold inline-flex items-center gap-1 transition-colors">
        Read Report <ArrowRight class="w-3 h-3" />
      </a>
    </div>

    <!-- Contact & Location Info -->
    <div class="hidden lg:flex items-center gap-4 text-slate-300">
      <a href="tel:+18005557539" class="hover:text-white transition-colors flex items-center gap-1.5">
        <Phone class="w-3.5 h-3.5 text-[#20C5CA]" />
        <span>USA: +1 (800) 555-PLEX</span>
      </a>
      <span class="text-slate-600">•</span>
      <a href="mailto:contact@plexera.com" class="hover:text-white transition-colors flex items-center gap-1.5">
        <Mail class="w-3.5 h-3.5 text-[#20C5CA]" />
        <span>contact@plexera.com</span>
      </a>
      <span class="text-slate-600">•</span>
      <div class="flex items-center gap-1.5 text-slate-200">
        <Globe class="w-3.5 h-3.5 text-[#20C5CA]" />
        <span>Delaware, USA & Pune, India</span>
      </div>
    </div>
  </div>
</div>
