---
import { ChevronDown, HelpCircle } from 'lucide-astro';

const faqs = [
  {
    q: "Do you guarantee a job?",
    a: "While final hiring decisions rest with employer interview panels, PlexEra delivers a proven 98% placement success rate through recruiter-tested ATS resume revamps, targeted application engines submitting 100+ matching roles per week, 1-on-1 mock interviews, and offer negotiation coaching."
  },
  {
    q: "Who can apply?",
    a: "Tech professionals across all experience levels—from ambitious junior candidates and career transitioners to senior software engineers, cloud architects, engineering managers, data engineers, and IT specialists looking to advance their compensation."
  },
  {
    q: "Do you work with international candidates?",
    a: "Yes! We support US Citizens, Permanent Residents (Green Card), OPT/STEM OPT candidates, H-1B visa holders, and international technology specialists seeking remote or US-aligned tech placements."
  },
  {
    q: "What services do you provide?",
    a: "We offer end-to-end career elevation and staffing solutions: ATS Resume & LinkedIn Revamps, Targeted Job Application Execution, 1-on-1 Executive Interview Coaching, Salary & Offer Negotiation, Enterprise IT Staffing, and First-Year Job Support."
  },
  {
    q: "How does the application process work?",
    a: "After an initial strategy consultation, our team conducts a comprehensive technical profile audit, optimizes your resume for ATS algorithms, launches targeted application campaigns across 100+ matching vacancies, and prepares you with mock interviews until offer acceptance."
  },
  {
    q: "How do I submit my resume?",
    a: "You can submit your resume directly by clicking 'Book Free Consult' or filling out the form on our Contact page. Our technical recruitment strategists will analyze your profile and contact you within 24 hours."
  },
  {
    q: "How are fees structured?",
    a: "We maintain 100% transparent, value-driven pricing structures with clear milestones and no hidden fees. Detailed program pricing for candidates is reviewed during your initial strategy call, while enterprise staffing operates on custom contract or direct-hire models."
  },
  {
    q: "What happens after I enroll?",
    a: "Upon enrollment, you are assigned a dedicated Career Advisor and Technical Lead. Within 48 hours, we complete your resume revamp, configure your targeted application strategy, and begin scheduling your 1-on-1 technical mock interview rounds."
  },
  {
    q: "How does PlexEra differ from traditional staffing or resume agencies?",
    a: "We provide a complete 360-degree career lifecycle. Unlike standalone resume writers or automated job boards, we handle everything: resume revamps, active application submissions, technical interview coaching, salary negotiation, and 12 months of post-hire job support."
  },
  {
    q: "Does PlexEra serve both candidates and enterprise employers?",
    a: "Yes! We operate a dual-pathway engine. For job seekers, we accelerate placement and boost compensation. For employers, we deliver pre-vetted, roadmap-ready engineering talent via contract, direct hire, and RPO solutions."
  },
  {
    q: "What tech stacks and roles does PlexEra specialize in?",
    a: "We specialize across Full-Stack Engineering (React, Node, Python, Java, Go), Cloud Infrastructure (AWS, Azure, Kubernetes, DevOps), Data Science & AI (Machine Learning, Data Engineering), Cybersecurity, ServiceNow, Financial Analytics, and Engineering Leadership."
  },
  {
    q: "How does the First-Year Job Support safety net work?",
    a: "Once placed in a new role, you gain ongoing access to our senior engineering mentors for architectural guidance, code review assistance, and onboarding advice during your first 12 months to guarantee high performance and retention."
  }
];
---

<section class="py-10 sm:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center mb-8 sm:mb-14">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#20C5CA]/15 border border-[#20C5CA]/30 text-[#041B3B] dark:text-[#20C5CA] text-xs font-bold uppercase tracking-wider mb-2 shadow-xs">
      <HelpCircle class="w-3.5 h-3.5 text-[#19A4A8]" />
      <span>Got Questions?</span>
    </div>
    <h2 class="text-2xl sm:text-5xl font-extrabold text-[#041B3B] dark:text-white mt-1 tracking-tight">Frequently Asked Questions</h2>
    <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-base mt-2 max-w-2xl mx-auto">Everything you need to know about our recruitment & career acceleration process.</p>
  </div>

  <div class="space-y-3 sm:space-y-3.5">
    {faqs.map((faq, index) => (
      <div class={`bg-white dark:bg-[#121215] rounded-2xl border border-slate-200/90 dark:border-white/8 shadow-xs hover:border-[#20C5CA]/50 dark:hover:border-[#20C5CA]/40 overflow-hidden transition-all ${index >= 5 ? 'hidden sm:block faq-extra-item' : ''}`}>
        <button
          onclick={`toggleFaq(${index})`}
          class="w-full p-4 sm:p-6 text-left flex items-center justify-between gap-4 font-bold text-xs sm:text-base text-[#041B3B] dark:text-slate-100 hover:text-[#0284c7] dark:hover:text-[#20C5CA] transition-colors cursor-pointer focus:outline-none"
          aria-expanded="false"
        >
          <span>{faq.q}</span>
          <ChevronDown id={`faq-icon-${index}`} class="w-4 h-4 sm:w-5 sm:h-5 text-[#19A4A8] shrink-0 transition-transform duration-200" />
        </button>
        <div id={`faq-ans-${index}`} class="hidden px-4 sm:px-6 pb-4 sm:pb-6 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-100 dark:border-white/8 pt-3 sm:pt-3.5">
          {faq.a}
        </div>
      </div>
    ))}
  </div>

  <!-- Mobile Show More Questions Button -->
  <div class="mt-6 text-center sm:hidden" id="faq-load-more-container">
    <button
      id="faq-show-more-btn"
      onclick="showMoreFaqs()"
      type="button"
      class="w-full py-3 rounded-xl bg-slate-100 dark:bg-white/8 text-xs font-bold text-[#041B3B] dark:text-slate-200 border border-slate-200 dark:border-white/10 hover:bg-slate-200 transition-colors cursor-pointer"
    >
      View All 12 Questions ↓
    </button>
  </div>
</section>


<script is:inline>
  function toggleFaq(index) {
    const ans = document.getElementById(`faq-ans-${index}`);
    const icon = document.getElementById(`faq-icon-${index}`);
    if (ans && icon) {
      const isHidden = ans.classList.contains('hidden');
      ans.classList.toggle('hidden');
      icon.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
    }
  }

  function showMoreFaqs() {
    document.querySelectorAll('.faq-extra-item').forEach(el => el.classList.remove('hidden'));
    const btnContainer = document.getElementById('faq-load-more-container');
    if (btnContainer) btnContainer.classList.add('hidden');
  }
</script>
