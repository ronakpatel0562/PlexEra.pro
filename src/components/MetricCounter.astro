---
import { Users, TrendingUp, Zap, Building2 } from "lucide-astro";
---

<section
  class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 mb-20 relative z-20"
>
  <div
    class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xl"
  >
    <div
      class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 divide-y lg:divide-y-0 lg:divide-x divide-slate-100"
    >
      <!-- Stat 1 -->
      <div class="flex flex-col items-center text-center p-4">
        <div
          class="p-3 rounded-2xl bg-[#041B3B]/10 text-[#041B3B] mb-3 border border-[#041B3B]/15"
        >
          <Users class="w-6 h-6" />
        </div>
        <span
          class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#041B3B] tracking-tight"
          >550+</span
        >
        <span class="text-xs sm:text-sm font-semibold text-slate-600 mt-1"
          >Tech Professionals Placed</span
        >
      </div>

      <!-- Stat 2 -->
      <div class="flex flex-col items-center text-center p-4 pt-6 lg:pt-4">
        <div
          class="p-3 rounded-2xl bg-[#20C5CA]/15 text-[#041B3B] mb-3 border border-[#20C5CA]/30"
        >
          <TrendingUp class="w-6 h-6" />
        </div>
        <span
          class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#041B3B] tracking-tight"
          >95%</span
        >
        <span class="text-xs sm:text-sm font-semibold text-slate-600 mt-1"
          >Interview Success Rate</span
        >
      </div>

      <!-- Stat 3 -->
      <div class="flex flex-col items-center text-center p-4 pt-6 lg:pt-4">
        <div
          class="p-3 rounded-2xl bg-sky-500/10 text-sky-700 mb-3 border border-sky-500/20"
        >
          <Zap class="w-6 h-6" />
        </div>
        <span
          class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#041B3B] tracking-tight"
          >98%</span
        >
        <span class="text-xs sm:text-sm font-semibold text-slate-600 mt-1"
          >Job Search Efficiency Boost</span
        >
      </div>

      <!-- Stat 4 -->
      <div class="flex flex-col items-center text-center p-4 pt-6 lg:pt-4">
        <div
          class="p-3 rounded-2xl bg-emerald-500/10 text-emerald-700 mb-3 border border-emerald-500/20"
        >
          <Building2 class="w-6 h-6" />
        </div>
        <span
          class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#041B3B] tracking-tight"
          >100+</span
        >
        <span class="text-xs sm:text-sm font-semibold text-slate-600 mt-1"
          >Partnered MNCs & Scale-Ups</span
        >
      </div>
    </div>
  </div>
</section>
