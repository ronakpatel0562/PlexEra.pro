// Combine categories for JSON embedding
const allCategoriesData = [...itCategories, ...nonItCategories].reduce((acc, cat) => {
  acc[cat.id] = {
    id: cat.id,
    name: cat.name,
    sector: cat.id.startsWith('it-') ? 'IT SECTOR' : 'NON-IT SECTOR',
    color: cat.color,
    roles: cat.roles
  };
  return acc;
}, {} as Record<string, any>);
---

<section class="py-20 bg-gradient-to-b from-white via-slate-50/50 to-white border-y border-slate-200 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Matches Image 2) -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-extrabold uppercase tracking-widest text-[#0284c7]">YOUR CAREER. OUR EXPERTISE.</span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#041B3B] mt-2 tracking-tight">
        Explore Opportunities <span class="bg-gradient-to-r from-[#0284c7] via-[#19A4A8] to-[#20C5CA] bg-clip-text text-transparent">Across Industries</span>
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-3 font-medium leading-relaxed">
        Whether you're in IT or Non-IT, we connect talented professionals with leading companies and meaningful opportunities.
      </p>
      
      <!-- Decorative Accent Line -->
      <div class="flex items-center justify-center gap-1.5 mt-4">
        <span class="w-10 h-1 bg-[#0284c7] rounded-full"></span>
        <span class="w-6 h-1 bg-[#19A4A8]/60 rounded-full"></span>
        <span class="w-2 h-1 bg-[#20C5CA]/40 rounded-full"></span>
      </div>
    </div>

    <!-- Main Split Grid Container (IT Sector vs Non-IT Sector) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      
      <!-- ================= IT SECTOR BOX ================= -->
      <div class="bg-gradient-to-b from-[#f0f7ff] via-[#f5f9ff] to-white rounded-3xl p-6 sm:p-8 border border-sky-200/80 shadow-sm relative flex flex-col justify-between hover:shadow-md transition-shadow">
        
        <div>
          <!-- Header Banner -->
          <div class="flex items-start justify-between gap-4 mb-6">
            <div class="space-y-2">
              <span class="inline-block px-3 py-1 rounded-full bg-sky-100/90 text-[#0284c7] font-extrabold text-[11px] uppercase tracking-wider border border-sky-200">
                IT SECTOR
              </span>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-[#041B3B] tracking-tight">
                Build the Future with Technology
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 font-medium leading-relaxed">
                From code to cloud, explore top IT roles that power innovation.
              </p>
            </div>

            <!-- Laptop Graphic Illustration -->
            <div class="hidden sm:flex shrink-0 w-20 h-20 rounded-2xl bg-gradient-to-br from-sky-500 to-[#041B3B] items-center justify-center text-white shadow-lg shadow-sky-500/20 relative group">
              <div class="absolute -top-1 -right-1 w-3 h-3 bg-[#20C5CA] rounded-full animate-ping"></div>
              <div class="p-3 bg-white/15 backdrop-blur-xs rounded-xl">
                <Code class="w-8 h-8 text-sky-200" />
              </div>
            </div>
          </div>

          <!-- Category Buttons Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mt-6">
            {itCategories.map((cat) => {
              const Icon = cat.icon;
              return (
                <button
                  type="button"
                  data-category-id={cat.id}
                  class="category-btn bg-white hover:bg-sky-50/60 border border-slate-200/90 hover:border-sky-300 rounded-2xl p-3.5 flex items-center justify-between shadow-xs hover:shadow-md transition-all duration-200 group text-left w-full cursor-pointer"
                >
                  <div class="flex items-center gap-3 pr-2">
                    <div class="p-2 rounded-xl bg-sky-50 text-[#0284c7] border border-sky-100 group-hover:bg-[#0284c7] group-hover:text-white transition-colors shrink-0">
                      <Icon class="w-4 h-4" />
                    </div>
                    <span class="font-bold text-xs sm:text-sm text-[#041B3B] group-hover:text-[#0284c7] transition-colors leading-tight">
                      {cat.name}
                    </span>
                  </div>
                  <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-[#0284c7] group-hover:translate-x-1 transition-all shrink-0" />
                </button>
              );
            })}
          </div>
        </div>

      </div>

      <!-- ================= NON-IT SECTOR BOX ================= -->
      <div class="bg-gradient-to-b from-[#fff8f0] via-[#fffbf7] to-white rounded-3xl p-6 sm:p-8 border border-amber-200/80 shadow-sm relative flex flex-col justify-between hover:shadow-md transition-shadow">
        
        <div>
          <!-- Header Banner -->
          <div class="flex items-start justify-between gap-4 mb-6">
            <div class="space-y-2">
              <span class="inline-block px-3 py-1 rounded-full bg-amber-100/90 text-amber-700 font-extrabold text-[11px] uppercase tracking-wider border border-amber-200">
                NON-IT SECTOR
              </span>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-[#041B3B] tracking-tight">
                Powering Diverse Industries
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 font-medium leading-relaxed">
                From manufacturing to healthcare, we help you find the right talent across every sector.
              </p>
            </div>

            <!-- Factory / Industry Illustration -->
            <div class="hidden sm:flex shrink-0 w-20 h-20 rounded-2xl bg-gradient-to-br from-amber-500 to-amber-900 items-center justify-center text-white shadow-lg shadow-amber-500/20 relative group">
              <div class="absolute -top-1 -right-1 w-3 h-3 bg-amber-300 rounded-full animate-ping"></div>
              <div class="p-3 bg-white/15 backdrop-blur-xs rounded-xl">
                <Wrench class="w-8 h-8 text-amber-200" />
              </div>
            </div>
          </div>

          <!-- Category Buttons Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mt-6">
            {nonItCategories.map((cat) => {
              const Icon = cat.icon;
              return (
                <button
                  type="button"
                  data-category-id={cat.id}
                  class="category-btn bg-white hover:bg-amber-50/60 border border-slate-200/90 hover:border-amber-300 rounded-2xl p-3.5 flex items-center justify-between shadow-xs hover:shadow-md transition-all duration-200 group text-left w-full cursor-pointer"
                >
                  <div class="flex items-center gap-3 pr-2">
                    <div class="p-2 rounded-xl bg-amber-50 text-amber-600 border border-amber-100 group-hover:bg-amber-600 group-hover:text-white transition-colors shrink-0">
                      <Icon class="w-4 h-4" />
                    </div>
                    <span class="font-bold text-xs sm:text-sm text-[#041B3B] group-hover:text-amber-700 transition-colors leading-tight">
                      {cat.name}
                    </span>
                  </div>
                  <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-amber-600 group-hover:translate-x-1 transition-all shrink-0" />
                </button>
              );
            })}
          </div>
        </div>

      </div>

    </div>

    <!-- ================= BOTTOM CONVERSION BANNER (Matches Image 2 Bottom) ================= -->
    <div class="bg-gradient-to-r from-emerald-50/90 via-teal-50/90 to-sky-50/90 border border-emerald-200/70 rounded-3xl p-6 sm:p-8 mt-10 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
      
      <div class="flex items-center gap-4 text-left">
        <div class="p-4 rounded-2xl bg-white text-[#0284c7] shadow-md border border-emerald-100 shrink-0">
          <Handshake class="w-8 h-8 text-[#19A4A8]" />
        </div>
        <div>
          <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#19A4A8]">
            LET'S BUILD GREAT TEAMS TOGETHER
          </span>
          <h3 class="text-xl sm:text-2xl font-extrabold text-[#041B3B] mt-0.5">
            Your Next Opportunity is Just a Click Away
          </h3>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-2 text-xs font-bold text-slate-700">
            <span class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-emerald-600" /> Trusted by Top Companies</span>
            <span class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-emerald-600" /> Wide Range of Roles</span>
            <span class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-emerald-600" /> Personalized Support</span>
            <span class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-emerald-600" /> Long-Term Career Growth</span>
          </div>
        </div>
      </div>

      <button 
        onclick="openBookingModal('candidate')"
        class="w-full md:w-auto px-8 py-3.5 text-sm font-bold text-white bg-[#0284c7] hover:bg-[#0369a1] rounded-full shadow-lg shadow-sky-500/25 flex items-center justify-center gap-2 cursor-pointer transition-all hover:scale-105 shrink-0"
      >
        <span>Explore Jobs</span>
        <ArrowRight class="w-4 h-4" />
      </button>
    </div>

  </div>
</section>

<!-- ================= CATEGORY ROLES POPUP MODAL ================= -->
<div 
  id="category-roles-modal" 
  class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6 bg-slate-900/60 backdrop-blur-sm overflow-y-auto"
>
  <div class="relative w-full max-w-3xl bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-2xl animate-fade-in my-auto max-h-[90vh] flex flex-col">
    
    <!-- Modal Close Button -->
    <button 
      id="close-category-modal-btn"
      class="absolute top-5 right-5 p-2 rounded-xl text-slate-400 hover:text-[#041B3B] hover:bg-slate-100 transition-colors z-10 cursor-pointer"
      aria-label="Close modal"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Modal Dynamic Header -->
    <div class="mb-6 pb-4 border-b border-slate-100 pr-10 shrink-0">
      <div class="flex items-center gap-3">
        <span 
          id="modal-sector-badge" 
          class="px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider"
        >
          SECTOR
        </span>
        <span class="text-xs font-bold text-slate-500">TAXONOMY PROFILE</span>
      </div>

      <h3 
        id="modal-category-name" 
        class="text-2xl sm:text-3xl font-extrabold text-[#041B3B] mt-2 flex items-center gap-3"
      >
        Category Name
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 mt-1 font-medium">
        Explore supported roles and specialized placement pathways we offer under this category.
      </p>
    </div>

    <!-- Modal Roles List / Grid (Scrollable) -->
    <div 
      id="modal-roles-grid" 
      class="overflow-y-auto space-y-3 pr-1 py-1 flex-1 text-left"
    >
      <!-- Dynamically populated via JS -->
    </div>

    <!-- Modal Footer Actions -->
    <div class="mt-6 pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3 shrink-0">
      <p class="text-xs font-semibold text-slate-500 text-center sm:text-left">
        Ready to hire or apply for roles in this category?
      </p>
      <div class="flex items-center gap-3 w-full sm:w-auto">
        <button 
          id="modal-apply-btn"
          class="flex-1 sm:flex-initial px-5 py-2.5 rounded-xl bg-[#041B3B] hover:bg-[#082854] text-white font-bold text-xs shadow-md transition-all cursor-pointer"
        >
          Apply / Book Advisory Call →
        </button>
      </div>
    </div>

  </div>
</div>

<!-- Embed JavaScript for Interactive Category Popup Modal -->
<script is:inline define:vars={{ allCategoriesData }}>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('category-roles-modal');
    const closeBtn = document.getElementById('close-category-modal-btn');
    const modalSectorBadge = document.getElementById('modal-sector-badge');
    const modalCategoryName = document.getElementById('modal-category-name');
    const modalRolesGrid = document.getElementById('modal-roles-grid');
    const modalApplyBtn = document.getElementById('modal-apply-btn');

    function openModalForCategory(categoryId) {
      const data = allCategoriesData[categoryId];
      if (!data) return;

      // Update badge
      if (data.sector === 'IT SECTOR') {
        modalSectorBadge.textContent = 'IT SECTOR';
        modalSectorBadge.className = 'px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-sky-100 text-[#0284c7] border border-sky-200';
      } else {
        modalSectorBadge.textContent = 'NON-IT SECTOR';
        modalSectorBadge.className = 'px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-amber-100 text-amber-700 border border-amber-200';
      }

      // Update category title
      modalCategoryName.textContent = data.name;

      // Populate roles
      modalRolesGrid.innerHTML = data.roles.map((role) => `
        <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200/80 hover:border-slate-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3 group">
          <div>
            <h4 class="font-extrabold text-base text-[#041B3B] group-hover:text-[#0284c7] transition-colors">${role.name}</h4>
            <p class="text-xs text-slate-600 mt-1 font-medium">${role.desc}</p>
          </div>
          <button 
            type="button"
            onclick="openBookingFromRole('${role.name}')"
            class="self-start sm:self-center px-3.5 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-[#0284c7] text-xs font-bold text-[#041B3B] hover:text-[#0284c7] shadow-2xs transition-all shrink-0 cursor-pointer"
          >
            Select Role →
          </button>
        </div>
      `).join('');

      // Show modal
      modal.classList.remove('hidden');
    }

    function closeModal() {
      modal.classList.add('hidden');
    }

    // Attach category button click handlers
    document.querySelectorAll('.category-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const categoryId = btn.getAttribute('data-category-id');
        openModalForCategory(categoryId);
      });
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    // Modal backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    if (modalApplyBtn) {
      modalApplyBtn.addEventListener('click', () => {
        closeModal();
        const bookingModal = document.getElementById('booking-modal');
        if (bookingModal) {
          bookingModal.classList.remove('hidden');
        }
      });
    }
  });

  window.openBookingFromRole = function(roleName) {
    const modal = document.getElementById('category-roles-modal');
    if (modal) modal.classList.add('hidden');
    
    const bookingModal = document.getElementById('booking-modal');
    if (bookingModal) {
      bookingModal.classList.remove('hidden');
    }
  };
</script>
