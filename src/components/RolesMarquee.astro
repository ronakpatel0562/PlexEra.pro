    id: "nonit-hr",
    name: "Human Resources",
    icon: Users,
    color: "amber",
    roles: [
      { name: "Talent Acquisition Specialist", desc: "Technical Sourcing, Candidate Vetting, Applicant Tracking Systems" },
      { name: "HR Operations Manager", desc: "Payroll Processing, HRIS (Workday/BambooHR), Employee Onboarding" },
