---
import { Code, Cloud, Cpu, Shield, Layers, Briefcase, ArrowRight } from 'lucide-astro';

const categories = [
  {
    name: "Software Engineering",
    icon: Code,
    roles: ["Full-Stack Engineer", "Frontend React/Next.js", "Backend Node/Go/Java Architect", "Mobile (iOS/Android)"]
  },
  {
    name: "Cloud & DevOps",
    icon: Cloud,
    roles: ["AWS/Azure Cloud Architect", "DevOps Engineer", "Kubernetes Specialist", "Site Reliability Lead"]
  },
  {
    name: "Data & AI",
    icon: Cpu,
    roles: ["Machine Learning Engineer", "Data Engineer", "AI Solutions Developer", "BI Data Analyst"]
  },
  {
    name: "Cybersecurity & Infra",
    icon: Shield,
    roles: ["Security Operations Lead", "Penetration Tester", "Cloud Security Architect", "Network Engineer"]
  },
  {
    name: "Specialized Platforms",
    icon: Layers,
    roles: ["ServiceNow Developer", "Salesforce Architect", "SAP Specialist", "Workday Engineer"]
  },
  {
    name: "High-Impact Non-IT",
    icon: Briefcase,
    roles: ["Technical Product Manager", "Financial Data Analyst", "Healthcare Analytics Lead", "Supply Chain Strategist"]
  }
];
---

<section class="py-20 bg-white border-y border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#19A4A8]">TAXONOMY OF EXCELLENCE</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#041B3B] mt-2">Roles We Excel in Placing</h2>
        <p class="text-slate-600 text-sm mt-1">Deep architectural alignment across modern tech stacks and strategic leadership.</p>
      </div>
      <a href="/roles" class="inline-flex items-center gap-2 text-sm font-bold text-[#041B3B] hover:text-[#0284c7] transition-colors">
        <span>Explore All 23+ Roles</span>
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((cat) => {
        const Icon = cat.icon;
        return (
          <div class="bg-[#f8fafc] rounded-3xl p-6 border border-slate-200 hover:border-slate-300 transition-all">
            <div class="flex items-center gap-3 mb-4">
              <div class="p-2.5 rounded-xl bg-[#20C5CA]/15 text-[#041B3B] border border-[#20C5CA]/30">
                <Icon class="w-5 h-5" />
              </div>
              <h3 class="font-extrabold text-lg text-[#041B3B]">{cat.name}</h3>
            </div>

            <div class="flex flex-wrap gap-2 pt-2">
              {cat.roles.map((role) => (
                <span class="px-3 py-1.5 rounded-xl bg-white hover:bg-[#20C5CA]/10 text-xs font-semibold text-slate-700 border border-slate-200 transition-colors cursor-default">
                  {role}
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
