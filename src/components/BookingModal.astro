---
import { X, Calendar, Upload, CheckCircle2, User, Building } from 'lucide-astro';
---

<div id="booking-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6 md:p-10 bg-slate-900/70 backdrop-blur-sm overflow-y-auto">
  <div class="relative w-full max-w-2xl bg-white dark:bg-[#071931] rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-700/80 shadow-2xl animate-fade-in my-auto transition-colors duration-300">
    
    <!-- Modal Close Button -->
    <button 
      onclick="closeBookingModal()"
      class="absolute top-5 right-5 p-2 rounded-xl text-slate-400 dark:text-slate-400 hover:text-[#041B3B] dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
      aria-label="Close modal"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Header -->
    <div class="text-center mb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#20C5CA]/15 border border-[#20C5CA]/30 text-[#041B3B] dark:text-[#20C5CA] text-xs font-bold uppercase tracking-wider mb-2">
        <Calendar class="w-3.5 h-3.5 text-[#19A4A8]" />
        <span>Free Advisory Session</span>
      </div>
      <h3 id="modal-title" class="text-2xl sm:text-3xl font-extrabold text-[#041B3B] dark:text-white">Book Your 1-on-1 Strategy Call</h3>
      <p id="modal-subtitle" class="text-sm text-slate-600 dark:text-slate-300 mt-1">Connect with senior PlexEra talent strategists.</p>
    </div>

    <!-- Audience Tab Switcher (Visible only when un-locked / generic) -->
    <div id="modal-tab-switcher" class="flex p-1 bg-slate-100 dark:bg-slate-800/80 rounded-2xl border border-slate-200 dark:border-slate-700 mb-6">
      <button 
        id="tab-candidate-btn"
        onclick="switchModalTab('candidate')"
        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 bg-[#041B3B] text-white shadow-md cursor-pointer"
      >
        <User class="w-4 h-4 text-[#20C5CA]" />
        <span>Candidate / Job Seeker</span>
      </button>
      <button 
        id="tab-employer-btn"
        onclick="switchModalTab('employer')"
        class="flex-1 py-2.5 text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-300 hover:text-[#041B3B] dark:hover:text-white rounded-xl transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <Building class="w-4 h-4" />
        <span>Employer / Enterprise</span>
      </button>
    </div>

    <!-- Candidate Form -->
    <form id="form-candidate" class="space-y-4" onsubmit="event.preventDefault(); handleModalFormSubmit(this, 'Candidate');">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Full Name *</label>
          <input type="text" name="fullName" required placeholder="e.g. Alex Mercer" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Email Address *</label>
          <input type="email" name="email" required placeholder="alex@domain.com" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Target Role Category *</label>
          <select id="candidate-role-select" name="roleCategory" required class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-[#20C5CA] transition-colors">
            <option value="">Select Primary Specialty...</option>
            <option value="Full-Stack / Frontend / Backend">Full-Stack / Frontend / Backend</option>
            <option value="Cloud & DevOps / Site Reliability">Cloud & DevOps / Site Reliability</option>
            <option value="Data Science / AI & ML Engineering">Data Science / AI & ML Engineering</option>
            <option value="Cybersecurity / Security Lead">Cybersecurity / Security Lead</option>
            <option value="Product Manager / Scrum Lead">Product Manager / Scrum Lead</option>
            <option value="Mechanical & Manufacturing Engineering">Mechanical & Manufacturing Engineering</option>
            <option value="Automation & Controls / PLC">Automation & Controls / PLC</option>
            <option value="Supply Chain & Logistics">Supply Chain & Logistics</option>
            <option value="Healthcare & Life Sciences">Healthcare & Life Sciences</option>
            <option value="Civil & Construction Engineering">Civil & Construction Engineering</option>
            <option value="Financial & Business Analysis">Financial & Business Analysis</option>
            <option value="Other High-Impact Role">Other High-Impact Role</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Years of Experience *</label>
          <select name="experience" required class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-[#20C5CA] transition-colors">
            <option value="1 - 3 Years">1 - 3 Years</option>
            <option value="4 - 7 Years (Mid/Senior)">4 - 7 Years (Mid/Senior)</option>
            <option value="8+ Years (Lead / Staff / Director)">8+ Years (Lead / Staff / Director)</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Resume / CV (Optional PDF/DOCX)</label>
        <div 
          id="resume-dropzone" 
          onclick="document.getElementById('candidate-resume-file').click()"
          class="border-2 border-dashed border-slate-200 dark:border-slate-700 hover:border-[#20C5CA] rounded-xl p-4 text-center cursor-pointer transition-colors bg-slate-50 dark:bg-slate-900/60"
        >
          <input 
            type="file" 
            id="candidate-resume-file" 
            name="attachment" 
            accept=".pdf,.doc,.docx" 
            class="hidden" 
            onchange="handleResumeFileSelected(this)"
          />
          <Upload class="w-5 h-5 mx-auto text-[#19A4A8] mb-1" />
          <span id="resume-filename" class="text-xs font-semibold text-slate-700 dark:text-slate-200 block">Click or drag resume file here to upload</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400">PDF, DOCX up to 10MB (Delivered to contact@plexera.pro)</span>
        </div>
      </div>

      <button 
        type="submit" 
        id="btn-submit-candidate"
        class="w-full py-3.5 px-6 rounded-xl neon-button text-sm font-bold shadow-md cursor-pointer transition-all flex items-center justify-center gap-2"
      >
        <span class="btn-text">Submit Candidate Application →</span>
        <span class="btn-spinner hidden items-center gap-2">
          <svg class="animate-spin h-4 w-4 text-[#041B3B]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span>Sending to contact@plexera.pro...</span>
        </span>
      </button>
    </form>

    <!-- Employer Booking Form -->
    <form id="form-employer" class="hidden space-y-4" onsubmit="event.preventDefault(); handleModalFormSubmit(this, 'Employer');">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Work Email *</label>
          <input type="email" name="workEmail" required placeholder="alex@company.com" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Company Name *</label>
          <input type="text" name="companyName" required placeholder="e.g. Acme Corp" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Staffing Service Model *</label>
          <select name="serviceModel" required class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-[#20C5CA] transition-colors">
            <option value="Contract / Sprint Augmentation">Contract / Sprint Augmentation</option>
            <option value="Direct Hire Placement">Direct Hire Placement</option>
            <option value="Full RPO Strategy">Full RPO Strategy</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Est. Team Size Needed *</label>
          <select name="teamSize" required class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-[#20C5CA] transition-colors">
            <option value="1 - 2 Engineers / Specialists">1 - 2 Engineers / Specialists</option>
            <option value="3 - 5 Engineers / Specialists">3 - 5 Engineers / Specialists</option>
            <option value="6+ Pod / Enterprise Scale">6+ Pod / Enterprise Scale</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Key Skillset & Requisition Details *</label>
        <textarea name="requisitionDetails" required rows="3" placeholder="Specify requirements (e.g. Next.js, SolidWorks, PLC Programming) and target hiring timeline..." class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors"></textarea>
      </div>

      <button 
        type="submit" 
        id="btn-submit-employer"
        class="w-full py-3.5 px-6 rounded-xl neon-button text-sm font-bold shadow-md cursor-pointer transition-all flex items-center justify-center gap-2"
      >
        <span class="btn-text">Request Talent Strategy Session →</span>
        <span class="btn-spinner hidden items-center gap-2">
          <svg class="animate-spin h-4 w-4 text-[#041B3B]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span>Sending to contact@plexera.pro...</span>
        </span>
      </button>
    </form>

    <!-- Error Message Alert -->
    <div id="booking-error" class="hidden my-4 p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-xs text-rose-700 dark:text-rose-300 space-y-2">
      <div class="font-bold flex items-center gap-1.5">
        <span>Submission encountered an issue.</span>
      </div>
      <p id="booking-error-text">Unable to complete request. Please verify your connection or reach us directly.</p>
      <div class="pt-1 border-t border-rose-200/60 dark:border-rose-800/50">
        <span>Direct Email: </span>
        <a id="booking-mailto-fallback" href="mailto:contact@plexera.pro" class="font-bold underline text-rose-800 dark:text-rose-200 hover:text-rose-950">contact@plexera.pro</a>
      </div>
    </div>

    <!-- Success Message Banner -->
    <div id="booking-success" class="hidden p-6 text-center space-y-3">
      <CheckCircle2 class="w-12 h-12 text-emerald-600 mx-auto" />
      <h4 class="text-xl font-bold text-[#041B3B] dark:text-white">Consultation Request Received!</h4>
      <p class="text-xs text-slate-600 dark:text-slate-300">Your details have been mailed to <span class="font-bold text-[#041B3B] dark:text-[#20C5CA]">contact@plexera.pro</span>. A senior PlexEra partner will reach out within 2 business hours to confirm your advisory time slot.</p>
      <div class="pt-2">
        <button 
          onclick="closeBookingModal()" 
          class="px-5 py-2 rounded-xl bg-[#041B3B] dark:bg-slate-800 hover:bg-[#082854] text-white text-xs font-bold transition-colors cursor-pointer"
        >
          Done
        </button>
      </div>
    </div>

    <!-- Trust Micro-Copy -->
    <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-700/80 flex items-center justify-between text-[11px] font-semibold text-slate-500 dark:text-slate-400">
      <span>⚡ Takes under 60 seconds</span>
      <span>🔒 100% Confidential</span>
      <span>📧 Routed to contact@plexera.pro</span>
    </div>

  </div>
</div>

<script is:inline>
  let _isOpeningProgrammatically = false;

  window.openBookingModal = function(mode, options = {}) {
    _isOpeningProgrammatically = true;
    const modal = document.getElementById('booking-modal');
    const tabSwitcher = document.getElementById('modal-tab-switcher');
    const titleEl = document.getElementById('modal-title');
    const subTitleEl = document.getElementById('modal-subtitle');
    const roleSelect = document.getElementById('candidate-role-select');
    const errorBox = document.getElementById('booking-error');

    if (errorBox) errorBox.classList.add('hidden');

    if (!modal) {
      _isOpeningProgrammatically = false;
      return;
    }

    // Determine target mode (explicit parameter -> page route -> default)
    let targetMode = mode;
    const path = window.location.pathname.toLowerCase();

    if (!targetMode || targetMode === 'auto') {
      if (path.includes('/candidates')) {
        targetMode = 'candidate';
      } else if (path.includes('/employers')) {
        targetMode = 'employer';
      } else {
        // Check active hero toggle if on homepage
        const heroCandidateActive = document.getElementById('hero-toggle-candidate')?.classList.contains('bg-[#041B3B]');
        const heroEmployerActive = document.getElementById('hero-toggle-employer')?.classList.contains('bg-[#041B3B]');
        if (heroEmployerActive) {
          targetMode = 'employer';
        } else {
          targetMode = 'candidate';
        }
      }
    }

    // Lock mode (hide tabs) whenever explicit audience mode ('candidate' or 'employer') is requested,
    // or when on dedicated single-audience pages (/candidates, /employers).
    let lockMode = true;
    if (options.lockMode !== undefined) {
      lockMode = options.lockMode;
    } else if (options.hideTabs !== undefined) {
      lockMode = options.hideTabs;
    } else if (mode === 'generic' || mode === 'auto') {
      lockMode = false;
    } else if (mode === 'candidate' || mode === 'employer') {
      lockMode = true;
    } else {
      lockMode = path.includes('/candidates') || path.includes('/employers');
    }

    if (lockMode && tabSwitcher) {
      tabSwitcher.classList.add('hidden');
    } else if (tabSwitcher) {
      tabSwitcher.classList.remove('hidden');
    }

    if (targetMode === 'candidate') {
      switchModalTab('candidate');
      if (titleEl) titleEl.textContent = 'Book Candidate Strategy Call';
      if (subTitleEl) subTitleEl.textContent = 'Submit your candidate profile to connect with senior PlexEra talent strategists.';
    } else {
      switchModalTab('employer');
      if (titleEl) titleEl.textContent = 'Request Technical Talent Strategy';
      if (subTitleEl) subTitleEl.textContent = 'Request custom talent sourcing & SLA delivery for your engineering team.';
    }

    // Pre-select role if provided
    if (options.role && roleSelect) {
      const roleLower = options.role.toLowerCase();
      let matched = false;
      for (let i = 0; i < roleSelect.options.length; i++) {
        const opt = roleSelect.options[i];
        const valLower = opt.value.toLowerCase();
        const textLower = opt.text.toLowerCase();
        if (valLower && (roleLower.includes(valLower) || textLower.includes(roleLower) || roleLower.includes(textLower))) {
          roleSelect.selectedIndex = i;
          matched = true;
          break;
        }
      }
    }

    modal.classList.remove('hidden');

    setTimeout(() => {
      _isOpeningProgrammatically = false;
    }, 150);
  };

  window.closeBookingModal = function() {
    const modal = document.getElementById('booking-modal');
    if (modal) modal.classList.add('hidden');
  };

  window.handleResumeFileSelected = function(input) {
    const filenameSpan = document.getElementById('resume-filename');
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
      if (filenameSpan) {
        filenameSpan.textContent = `✓ Selected: ${file.name} (${sizeMb} MB)`;
        filenameSpan.classList.add('text-teal-600', 'font-bold');
      }
    } else if (filenameSpan) {
      filenameSpan.textContent = 'Click or drag resume file here to upload';
      filenameSpan.classList.remove('text-teal-600', 'font-bold');
    }
  };

  // Drag & drop handlers for resume box
  document.addEventListener('DOMContentLoaded', () => {
    const dropzone = document.getElementById('resume-dropzone');
    const fileInput = document.getElementById('candidate-resume-file');
    if (dropzone && fileInput) {
      ['dragenter', 'dragover'].forEach(eventName => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('border-[#20C5CA]', 'bg-teal-50/50', 'dark:bg-teal-950/20');
        });
      });
      ['dragleave', 'drop'].forEach(eventName => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('border-[#20C5CA]', 'bg-teal-50/50', 'dark:bg-teal-950/20');
        });
      });
      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files.length) {
          fileInput.files = dt.files;
          window.handleResumeFileSelected(fileInput);
        }
      });
    }
  });

  function switchModalTab(tab) {
    const candBtn = document.getElementById('tab-candidate-btn');
    const empBtn = document.getElementById('tab-employer-btn');
    const candForm = document.getElementById('form-candidate');
    const empForm = document.getElementById('form-employer');
    const errorBox = document.getElementById('booking-error');

    if (errorBox) errorBox.classList.add('hidden');

    if (tab === 'candidate') {
      if (candBtn) candBtn.className = 'flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 bg-[#041B3B] text-white shadow-md cursor-pointer';
      if (empBtn) empBtn.className = 'flex-1 py-2.5 text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-300 hover:text-[#041B3B] dark:hover:text-white rounded-xl transition-all flex items-center justify-center gap-2 cursor-pointer';
      if (candForm) candForm.classList.remove('hidden');
      if (empForm) empForm.classList.add('hidden');
    } else {
      if (empBtn) empBtn.className = 'flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 neon-button shadow-md cursor-pointer';
      if (candBtn) candBtn.className = 'flex-1 py-2.5 text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-300 hover:text-[#041B3B] dark:hover:text-white rounded-xl transition-all flex items-center justify-center gap-2 cursor-pointer';
      if (empForm) empForm.classList.remove('hidden');
      if (candForm) candForm.classList.add('hidden');
    }
  }

  async function handleModalFormSubmit(formEl, type) {
    const submitBtn = formEl.querySelector('button[type="submit"]');
    const btnText = submitBtn ? submitBtn.querySelector('.btn-text') : null;
    const btnSpinner = submitBtn ? submitBtn.querySelector('.btn-spinner') : null;
    const errorBox = document.getElementById('booking-error');
    const errorText = document.getElementById('booking-error-text');
    const mailtoFallback = document.getElementById('booking-mailto-fallback');
    const successBox = document.getElementById('booking-success');
    const candForm = document.getElementById('form-candidate');
    const empForm = document.getElementById('form-employer');
    const tabSwitcher = document.getElementById('modal-tab-switcher');

    if (errorBox) errorBox.classList.add('hidden');

    // UI Loading state
    if (submitBtn) submitBtn.disabled = true;
    if (btnText) btnText.classList.add('hidden');
    if (btnSpinner) btnSpinner.classList.remove('hidden');

    const formData = new FormData(formEl);
    const applicantName = formData.get('fullName') || formData.get('companyName') || 'Portal Inquiry';
    const applicantEmail = formData.get('email') || formData.get('workEmail') || '';

    // Parameters for FormSubmit
    const subject = `[PlexEra] ${type} Consultation Request - ${applicantName}`;
    formData.set('_subject', subject);
    if (applicantEmail) {
      formData.set('_replyto', applicantEmail);
    }
    formData.set('_template', 'table');
    formData.set('_captcha', 'false');
    formData.set('Audience_Type', type);
    formData.set('Source_URL', window.location.href);
    formData.set('Submission_Time', new Date().toLocaleString());

    try {
      const response = await fetch('https://formsubmit.co/ajax/contact@plexera.pro', {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      });

      if (!response.ok) {
        const errJson = await response.json().catch(() => null);
        throw new Error(errJson?.message || `Server responded with status ${response.status}`);
      }

      // Success flow
      if (candForm) candForm.classList.add('hidden');
      if (empForm) empForm.classList.add('hidden');
      if (tabSwitcher) tabSwitcher.classList.add('hidden');
      if (successBox) successBox.classList.remove('hidden');

      formEl.reset();
      const filenameSpan = document.getElementById('resume-filename');
      if (filenameSpan) {
        filenameSpan.textContent = 'Click or drag resume file here to upload';
        filenameSpan.classList.remove('text-teal-600', 'font-bold');
      }

    } catch (err) {
      console.error('PlexEra Form Submission Error:', err);
      if (errorBox) {
        errorBox.classList.remove('hidden');
        if (errorText) {
          errorText.textContent = `Could not deliver online: ${err.message || 'Network error'}. You can email us directly.`;
        }
        if (mailtoFallback) {
          const bodyContent = encodeURIComponent(`Hello PlexEra Team,\n\nI would like to request an advisory consultation.\n\nType: ${type}\nName/Company: ${applicantName}\nEmail: ${applicantEmail}\n\nThank you.`);
          mailtoFallback.href = `mailto:contact@plexera.pro?subject=${encodeURIComponent(subject)}&body=${bodyContent}`;
        }
      }
    } finally {
      // Re-enable submit button
      if (submitBtn) submitBtn.disabled = false;
      if (btnText) btnText.classList.remove('hidden');
      if (btnSpinner) btnSpinner.classList.add('hidden');
    }
  }

  // MutationObserver to auto-configure modal ONLY if opened by raw classList.remove('hidden')
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('booking-modal');
    if (!modal) return;

    const observer = new MutationObserver((mutations) => {
      if (_isOpeningProgrammatically) return;

      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'class' && !modal.classList.contains('hidden')) {
          const path = window.location.pathname.toLowerCase();
          if (path.includes('/candidates')) {
            window.openBookingModal('candidate', { lockMode: true });
          } else if (path.includes('/employers')) {
            window.openBookingModal('employer', { lockMode: true });
          }
        }
      });
    });

    observer.observe(modal, { attributes: true });
  });
</script>
