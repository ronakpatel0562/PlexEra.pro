---
import { X, Calendar, Upload, CheckCircle2, User, Building } from 'lucide-astro';
---

<div id="booking-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6 md:p-10 bg-slate-900/60 backdrop-blur-sm overflow-y-auto">
  <div class="relative w-full max-w-2xl bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-2xl animate-fade-in my-auto">
    
    <!-- Modal Close Button -->
    <button 
      onclick="document.getElementById('booking-modal').classList.add('hidden')"
      class="absolute top-5 right-5 p-2 rounded-xl text-slate-400 hover:text-[#041B3B] hover:bg-slate-100 transition-colors"
      aria-label="Close modal"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Header -->
    <div class="text-center mb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#20C5CA]/15 border border-[#20C5CA]/30 text-[#041B3B] text-xs font-bold uppercase tracking-wider mb-2">
        <Calendar class="w-3.5 h-3.5 text-[#19A4A8]" />
        <span>Free Advisory Session</span>
      </div>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-[#041B3B]">Book Your 1-on-1 Strategy Call</h3>
      <p class="text-sm text-slate-600 mt-1">Select your path below to connect with senior PlexEra strategists.</p>
    </div>

    <!-- Audience Tab Switcher -->
    <div class="flex p-1 bg-slate-100 rounded-2xl border border-slate-200 mb-6">
      <button 
        id="tab-candidate-btn"
        onclick="switchModalTab('candidate')"
        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 bg-[#041B3B] text-white shadow-md"
      >
        <User class="w-4 h-4 text-[#20C5CA]" />
        <span>Candidate / Job Seeker</span>
      </button>
      <button 
        id="tab-employer-btn"
        onclick="switchModalTab('employer')"
        class="flex-1 py-2.5 text-xs sm:text-sm font-bold text-slate-600 hover:text-[#041B3B] rounded-xl transition-all flex items-center justify-center gap-2"
      >
        <Building class="w-4 h-4" />
        <span>Employer / Enterprise</span>
      </button>
    </div>

    <!-- Candidate Form -->
    <form id="form-candidate" class="space-y-4" onsubmit="event.preventDefault(); handleFormSubmit('Candidate');">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Full Name *</label>
          <input type="text" required placeholder="e.g. Alex Mercer" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Email Address *</label>
          <input type="email" required placeholder="alex@domain.com" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Target Role Category *</label>
          <select required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:border-[#20C5CA] transition-colors">
            <option value="">Select Primary Specialty...</option>
            <option value="fullstack">Full-Stack / Frontend / Backend</option>
            <option value="devops">Cloud & DevOps / Site Reliability</option>
            <option value="data">Data Science / AI & ML Engineering</option>
            <option value="cyber">Cybersecurity / Security Lead</option>
            <option value="pm">Product Manager / Scrum Lead</option>
            <option value="mechanical">Mechanical & Manufacturing Engineering</option>
            <option value="automation">Automation & Controls / PLC</option>
            <option value="supplychain">Supply Chain & Logistics</option>
            <option value="healthcare">Healthcare & Life Sciences</option>
            <option value="construction">Civil & Construction Engineering</option>
            <option value="finance">Financial & Business Analysis</option>
            <option value="other">Other High-Impact Role</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Years of Experience *</label>
          <select required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:border-[#20C5CA] transition-colors">
            <option value="1-3">1 - 3 Years</option>
            <option value="4-7">4 - 7 Years (Mid/Senior)</option>
            <option value="8+">8+ Years (Lead / Staff / Director)</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Resume / CV (Optional PDF/DOCX)</label>
        <div class="border-2 border-dashed border-slate-200 hover:border-[#20C5CA] rounded-xl p-4 text-center cursor-pointer transition-colors bg-slate-50">
          <Upload class="w-5 h-5 mx-auto text-[#19A4A8] mb-1" />
          <span class="text-xs font-semibold text-slate-700 block">Click or drag resume file here to upload</span>
          <span class="text-[10px] text-slate-500">PDF, DOCX up to 10MB</span>
        </div>
      </div>

      <button type="submit" class="w-full py-3.5 px-6 rounded-xl neon-button text-sm font-bold shadow-md cursor-pointer transition-all">
        Submit Candidate Application →
      </button>
    </form>

    <!-- Form 2: Employer Booking -->
    <form id="form-employer" class="hidden space-y-4" onsubmit="event.preventDefault(); handleFormSubmit('Employer');">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Work Email *</label>
          <input type="email" required placeholder="alex@company.com" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Company Name *</label>
          <input type="text" required placeholder="e.g. Acme Corp" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Staffing Service Model</label>
          <select class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:border-[#20C5CA] transition-colors">
            <option value="contract">Contract / Sprint Augmentation</option>
            <option value="direct">Direct Hire Placement</option>
            <option value="rpo">Full RPO Strategy</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Est. Team Size Needed</label>
          <select class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:border-[#20C5CA] transition-colors">
            <option value="1-2">1 - 2 Engineers / Specialists</option>
            <option value="3-5">3 - 5 Engineers / Specialists</option>
            <option value="6+">6+ Pod / Enterprise Scale</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Key Skillset & Requisition Details</label>
        <textarea rows="3" placeholder="Specify requirements (e.g. Next.js, SolidWorks, PLC Programming) and target hiring timeline..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors"></textarea>
      </div>

      <button type="submit" class="w-full py-3.5 px-6 rounded-xl neon-button text-sm font-bold shadow-md cursor-pointer transition-all">
        Request Talent Strategy Session →
      </button>
    </form>

    <!-- Success Message Banner -->
    <div id="booking-success" class="hidden p-6 text-center space-y-3">
      <CheckCircle2 class="w-12 h-12 text-emerald-600 mx-auto" />
      <h4 class="text-xl font-bold text-[#041B3B]">Consultation Request Received!</h4>
      <p class="text-xs text-slate-600">A senior PlexEra partner will reach out within 2 business hours to confirm your advisory time slot.</p>
    </div>

    <!-- Trust Micro-Copy -->
    <div class="mt-4 pt-4 border-t border-slate-200 flex items-center justify-between text-[11px] font-semibold text-slate-500">
      <span>⚡ Takes under 60 seconds</span>
      <span>🔒 100% Confidential</span>
      <span>🌐 USA & Global Coverage</span>
    </div>

  </div>
</div>

<script is:inline>
  function switchModalTab(tab) {
    const candBtn = document.getElementById('tab-candidate-btn');
    const empBtn = document.getElementById('tab-employer-btn');
    const candForm = document.getElementById('form-candidate');
    const empForm = document.getElementById('form-employer');

    if (tab === 'candidate') {
      candBtn.className = 'flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 bg-[#041B3B] text-white shadow-md';
      empBtn.className = 'flex-1 py-2.5 text-xs sm:text-sm font-bold text-slate-600 hover:text-[#041B3B] rounded-xl transition-all flex items-center justify-center gap-2';
      candForm.classList.remove('hidden');
      empForm.classList.add('hidden');
    } else {
      empBtn.className = 'flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 neon-button shadow-md';
      candBtn.className = 'flex-1 py-2.5 text-xs sm:text-sm font-bold text-slate-600 hover:text-[#041B3B] rounded-xl transition-all flex items-center justify-center gap-2';
      empForm.classList.remove('hidden');
      candForm.classList.add('hidden');
    }
  }

  function handleFormSubmit(type) {
    document.getElementById('form-candidate').classList.add('hidden');
    document.getElementById('form-employer').classList.add('hidden');
    document.getElementById('booking-success').classList.remove('hidden');
    setTimeout(() => {
      document.getElementById('booking-modal').classList.add('hidden');
      document.getElementById('booking-success').classList.add('hidden');
      document.getElementById('form-candidate').classList.remove('hidden');
    }, 4000);
  }
</script>
