---
import { Search, Sparkles, UserCheck, ShieldCheck } from 'lucide-astro';

const steps = [
  {
    num: "01",
    icon: Search,
    title: "Discovery & Alignment",
    description: "We conduct a deep 1-on-1 advisory call to evaluate candidate career goals or employer product roadmap requisitions."
  },
  {
    num: "02",
    icon: Sparkles,
    title: "Portfolio Elevation & Vetting",
    description: "We optimize resume framing, rebuild digital branding, and perform rigorous technical skill evaluation."
  },
  {
    num: "03",
    icon: UserCheck,
    title: "Targeted Matching & Coaching",
    description: "We execute targeted applications while conducting intensive mock interview coaching to ensure 95%+ interview pass rates."
  },
  {
    num: "04",
    icon: ShieldCheck,
    title: "Offer & First-Year Support",
    description: "We secure peak market compensation packages and maintain ongoing post-hire technical job support for long-term retention."
  }
];
---

<section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center mb-16">
    <span class="text-xs font-extrabold uppercase tracking-widest text-[#19A4A8]">OUR PROVEN METHODOLOGY</span>
    <h2 class="text-3xl sm:text-5xl font-extrabold text-[#041B3B] mt-2">The PlexEra Pathway: From Potential to Placement</h2>
    <p class="text-slate-600 max-w-2xl mx-auto mt-3 text-base">A disciplined 4-step framework engineered to remove friction and guarantee peak performance.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
    {steps.map((step) => {
      const Icon = step.icon;
      return (
        <div class="bg-white rounded-3xl p-7 border border-slate-200 shadow-sm hover:shadow-lg hover:border-slate-300 transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="font-mono text-3xl font-extrabold text-[#041B3B]/30 group-hover:text-[#041B3B] transition-colors">
                {step.num}
              </span>
              <div class="p-3 rounded-2xl bg-[#20C5CA]/15 text-[#041B3B] border border-[#20C5CA]/30 group-hover:bg-[#20C5CA] transition-colors">
                <Icon class="w-5 h-5" />
              </div>
            </div>

            <h3 class="text-lg font-bold text-[#041B3B] mb-2">{step.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{step.description}</p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-1.5 text-[11px] font-bold text-slate-400 group-hover:text-[#0284c7]">
            <span>Phase {step.num} Execution</span>
          </div>
        </div>
      );
    })}
  </div>
</section>
