---
import { UserCheck, Building2, CheckCircle, ArrowRight } from 'lucide-astro';
---

<section class="py-10 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center mb-8 sm:mb-14">
    <span class="text-xs font-extrabold uppercase tracking-widest text-[#19A4A8]">DUAL PATHWAY ENGINE</span>
    <h2 class="text-2xl sm:text-5xl font-extrabold text-[#041B3B] dark:text-white mt-2">Tailored Acceleration for Candidates & Employers</h2>
    <p class="text-slate-600 dark:text-slate-400 max-w-2xl mx-auto mt-2 sm:mt-3 text-sm sm:text-base">Select your trajectory below to see how PlexEra optimizes your potential.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
    
    <!-- Card A — For Candidates -->
    <div class="bg-white dark:bg-[#121215] rounded-3xl p-6 sm:p-10 border border-slate-200 dark:border-white/8 shadow-sm hover:shadow-xl dark:hover:shadow-black/50 transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
      <!-- Ambient Glow Accent -->
      <div class="absolute -top-20 -left-20 w-64 h-64 bg-sky-400/10 rounded-full blur-[80px] pointer-events-none group-hover:bg-sky-400/20 transition-all"></div>
      
      <div>
        <div class="flex items-center justify-between mb-4 sm:mb-6">
          <div class="p-2.5 sm:p-3.5 rounded-2xl bg-[#041B3B]/10 dark:bg-white/10 text-[#041B3B] dark:text-[#20C5CA] border border-[#041B3B]/15 dark:border-white/10">
            <UserCheck class="w-6 h-6 sm:w-7 sm:h-7" />
          </div>
          <span class="px-3 py-1 rounded-full bg-[#041B3B]/10 dark:bg-white/8 text-[#041B3B] dark:text-slate-200 text-[11px] sm:text-xs font-bold tracking-wider uppercase border border-[#041B3B]/15 dark:border-white/10">
            FOR CANDIDATES
          </span>
        </div>

        <h3 class="text-xl sm:text-3xl font-extrabold text-[#041B3B] dark:text-white leading-tight">
          Land Your Dream Tech Role <span class="text-[#0284c7] dark:text-[#20C5CA]">3x Faster.</span>
        </h3>

        <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-base mt-2.5 sm:mt-4 leading-relaxed">
          Stop sending resumes into automated ATS voids. Get end-to-end guidance—from resume revamps and mock interviews to compensation negotiation and first-year job support.
        </p>

        <ul class="mt-5 sm:mt-8 space-y-2.5 sm:space-y-3.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300 font-medium">
          <li class="flex items-start gap-2.5 sm:gap-3">
            <CheckCircle class="w-4 h-4 sm:w-5 sm:h-5 text-[#19A4A8] shrink-0 mt-0.5" />
            <span><strong class="text-[#041B3B] dark:text-white">ATS-Compliant Resume & LinkedIn Revamp:</strong><span class="hidden sm:inline"> Keyword-rich, recruiter-tested profiles.</span></span>
          </li>
          <li class="flex items-start gap-2.5 sm:gap-3">
            <CheckCircle class="w-4 h-4 sm:w-5 sm:h-5 text-[#19A4A8] shrink-0 mt-0.5" />
            <span><strong class="text-[#041B3B] dark:text-white">1-on-1 Mock Interviews:</strong><span class="hidden sm:inline"> Practice with senior tech leads from top tech firms.</span></span>
          </li>
          <li class="flex items-start gap-2.5 sm:gap-3">
            <CheckCircle class="w-4 h-4 sm:w-5 sm:h-5 text-[#19A4A8] shrink-0 mt-0.5" />
            <span><strong class="text-[#041B3B] dark:text-white">Targeted Application Engine:</strong><span class="hidden sm:inline"> 100+ precision applications submitted per week.</span></span>
          </li>
          <li class="flex items-start gap-2.5 sm:gap-3">
            <CheckCircle class="w-4 h-4 sm:w-5 sm:h-5 text-[#19A4A8] shrink-0 mt-0.5" />
            <span><strong class="text-[#041B3B] dark:text-white">Year-1 Onboarding Guarantee:</strong><span class="hidden sm:inline"> Continuous technical mentorship after placement.</span></span>
          </li>
        </ul>
      </div>

      <div class="mt-6 sm:mt-10 pt-4 sm:pt-6 border-t border-slate-200 dark:border-white/8">
        <a 
          href="/candidates"
          class="w-full py-3.5 sm:py-4 px-6 rounded-2xl bg-[#041B3B] hover:bg-[#082854] text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all shadow-md hover:shadow-lg"
        >
          <span>Start My Career Roadmap</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>

    <!-- Card B — For Employers -->
    <div class="bg-white dark:bg-[#121215] rounded-3xl p-6 sm:p-10 border border-slate-200 dark:border-white/8 shadow-sm hover:shadow-xl dark:hover:shadow-black/50 transition-all duration-300 relative overflow-hidden flex flex-col justify-between group">
      <!-- Ambient Glow Accent -->
      <div class="absolute -top-20 -right-20 w-64 h-64 bg-[#20C5CA]/10 rounded-full blur-[80px] pointer-events-none group-hover:bg-[#20C5CA]/20 transition-all"></div>

      <div>
        <div class="flex items-center justify-between mb-4 sm:mb-6">
          <div class="p-2.5 sm:p-3.5 rounded-2xl bg-[#20C5CA]/15 text-[#041B3B] dark:text-[#20C5CA] border border-[#20C5CA]/30">
            <Building2 class="w-6 h-6 sm:w-7 sm:h-7 text-[#041B3B] dark:text-[#20C5CA]" />
          </div>
          <span class="px-3 py-1 rounded-full bg-[#20C5CA]/15 text-[#041B3B] dark:text-[#20C5CA] text-[11px] sm:text-xs font-bold tracking-wider uppercase border border-[#20C5CA]/30">
            FOR EMPLOYERS
          </span>
        </div>

        <h3 class="text-xl sm:text-3xl font-extrabold text-[#041B3B] dark:text-white leading-tight">
          Build Product-Roadmap-Ready <span class="text-[#19A4A8]">Engineering Teams.</span>
        </h3>

        <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-base mt-2.5 sm:mt-4 leading-relaxed">
          Eliminate hiring bottlenecks with pre-vetted, high-capacity tech talent. We align recruitment with your software milestones and architectural goals.
        </p>

        <ul class="mt-5 sm:mt-8 space-y-2.5 sm:space-y-3.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300 font-medium">
          <li class="flex items-start gap-2.5 sm:gap-3">
            <CheckCircle class="w-4 h-4 sm:w-5 sm:h-5 text-[#19A4A8] shrink-0 mt-0.5" />
            <span><strong class="text-[#041B3B] dark:text-white">Direct Hire & Augmentation:</strong><span class="hidden sm:inline"> Deployed in as fast as 48 hours.</span></span>
          </li>
          <li class="flex items-start gap-2.5 sm:gap-3">
            <CheckCircle class="w-4 h-4 sm:w-5 sm:h-5 text-[#19A4A8] shrink-0 mt-0.5" />
            <span><strong class="text-[#041B3B] dark:text-white">Deep Technical Vetting:</strong><span class="hidden sm:inline"> Code challenges & architecture audits.</span></span>
          </li>
          <li class="flex items-start gap-2.5 sm:gap-3">
            <CheckCircle class="w-4 h-4 sm:w-5 sm:h-5 text-[#19A4A8] shrink-0 mt-0.5" />
            <span><strong class="text-[#041B3B] dark:text-white">Recruitment Process Outsourcing:</strong><span class="hidden sm:inline"> End-to-end talent sourcing pipelines.</span></span>
          </li>
          <li class="flex items-start gap-2.5 sm:gap-3">
            <CheckCircle class="w-4 h-4 sm:w-5 sm:h-5 text-[#19A4A8] shrink-0 mt-0.5" />
            <span><strong class="text-[#041B3B] dark:text-white">Compliance Assurance:</strong><span class="hidden sm:inline"> Full US & global back-office support.</span></span>
          </li>
        </ul>
      </div>

      <div class="mt-6 sm:mt-10 pt-4 sm:pt-6 border-t border-slate-200 dark:border-white/8">
        <a 
          href="/employers"
          class="w-full py-3.5 sm:py-4 px-6 rounded-2xl neon-button text-xs sm:text-sm font-bold flex items-center justify-center gap-2"
        >
          <span>Scale My Engineering Team</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>

  </div>
</section>

