---
import { ArrowRight, Sparkles, ShieldCheck, CheckCircle2, Award, Zap } from 'lucide-astro';
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden bg-gradient-to-b from-white via-slate-50 to-[#f8fafc]">
  <!-- Subtle Ambient Glow Background Overlay -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-full pointer-events-none -z-10">
    <div class="absolute top-10 left-1/4 w-[500px] h-[500px] bg-[#20C5CA]/10 rounded-full blur-[100px]"></div>
    <div class="absolute top-40 right-1/4 w-[400px] h-[400px] bg-sky-400/10 rounded-full blur-[90px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Eyebrow Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#20C5CA]/10 border border-[#20C5CA]/30 text-[#041B3B] text-xs sm:text-sm font-bold tracking-wide mb-8 shadow-xs">
      <Sparkles class="w-4 h-4 text-[#19A4A8]" />
      <span>REDEFINING IT & NON-IT STAFFING & CAREER ELEVATION</span>
    </div>

    <!-- H1 Headline -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-[#041B3B] max-w-5xl mx-auto leading-[1.1]">
      Where Potential <span class="relative inline-block text-[#0284c7]">Belongs.<span class="absolute bottom-2 left-0 w-full h-3 bg-[#20C5CA]/30 -z-10 rounded-xs"></span></span>
    </h1>

    <!-- Subheadline -->
    <p class="mt-4 text-xl sm:text-2xl font-semibold text-slate-700 max-w-3xl mx-auto">
      Accelerating Tech & Industry Careers with Precision Talent Sourcing.
    </p>

    <!-- Body Copy -->
    <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
      PlexEra pairs high-performing IT and Non-IT specialists with visionary enterprises. Whether you are a candidate seeking your next high-impact engineering or business role or an employer accelerating your operational roadmap, we engineer the perfect match.
    </p>

    <!-- Dual Action Buttons -->
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
      <button 
        onclick="document.getElementById('booking-modal').classList.remove('hidden')"
        class="w-full sm:w-auto px-8 py-4 text-base font-bold text-white bg-[#041B3B] hover:bg-[#082854] rounded-2xl flex items-center justify-center gap-2 shadow-lg shadow-[#041B3B]/15 transition-all hover:scale-[1.01] cursor-pointer"
      >
        <span>Elevate My Career</span>
        <ArrowRight class="w-5 h-5" />
      </button>

      <a 
        href="/employers"
        class="w-full sm:w-auto px-8 py-4 text-base font-bold neon-button rounded-2xl flex items-center justify-center gap-2"
      >
        <span>Hire Top Talent</span>
        <Zap class="w-4 h-4 text-[#041B3B]" />
      </a>
    </div>

    <!-- Trust Micro-Copy Strip -->
    <div class="mt-14 pt-8 border-t border-slate-200/80 max-w-3xl mx-auto flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-xs sm:text-sm font-semibold text-slate-600">
      <div class="flex items-center gap-2">
        <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
        <span>ATS-Optimized Strategies</span>
      </div>
      <div class="flex items-center gap-2">
        <Award class="w-4 h-4 text-[#041B3B] shrink-0" />
        <span>1-on-1 Executive Coaching</span>
      </div>
      <div class="flex items-center gap-2">
        <ShieldCheck class="w-4 h-4 text-[#19A4A8] shrink-0" />
        <span>First-Year Job Support Safety Net</span>
      </div>
    </div>

  </div>
</section>
