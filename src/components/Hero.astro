<!-- Combined Hero Interactivity & Animated Counter Script -->
<script>
  function setupHeroInteractivity() {
    // Mode Switcher Elements
    const btnCandidate = document.getElementById('hero-toggle-candidate');
    const btnEmployer = document.getElementById('hero-toggle-employer');
    
    const textCandidate = document.getElementById('hero-text-candidate');
    const textEmployer = document.getElementById('hero-text-employer');
    
    const panelCandidate = document.getElementById('card-panel-candidate');
    const panelEmployer = document.getElementById('card-panel-employer');

    const socialCandidate = document.getElementById('hero-social-candidate');
    const socialEmployer = document.getElementById('hero-social-employer');

    const statsCandidate = document.getElementById('hero-stats-candidate');
    const statsEmployer = document.getElementById('hero-stats-employer');

    const secCtaCandidate = document.getElementById('hero-sec-cta-candidate');
    const secCtaEmployer = document.getElementById('hero-sec-cta-employer');
    
    const cardStatusBadge = document.getElementById('card-status-badge');
    const primaryCtaLabel = document.getElementById('hero-primary-cta-label');

    function runCounters(container: HTMLElement) {
      const counters = container.querySelectorAll<HTMLElement>('.counter-value');
      counters.forEach(el => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        const suffix = el.getAttribute('data-suffix') || '';
        const prefix = el.getAttribute('data-prefix') || '';
        
        let start = 0;
        const duration = 1400;
        const startTime = performance.now();

        function step(currentTime: number) {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const easeProgress = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
          const currentVal = Math.floor(easeProgress * target);

          el.textContent = `${prefix}${currentVal}${suffix}`;

          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            el.textContent = `${prefix}${target}${suffix}`;
          }
        }

        requestAnimationFrame(step);
      });
    }

    if (btnCandidate && btnEmployer) {
      btnCandidate.addEventListener('click', () => {
        btnCandidate.className = "px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-300 flex items-center gap-2 bg-[#041B3B] text-white shadow-md cursor-pointer";
        btnEmployer.className = "px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-300 flex items-center gap-2 text-slate-600 hover:text-[#041B3B] cursor-pointer";

        // Text switch
        if (textCandidate && textEmployer) {
          textCandidate.classList.remove('hidden', 'opacity-0');
          textCandidate.classList.add('block', 'opacity-100');
          textEmployer.classList.remove('block', 'opacity-100');
          textEmployer.classList.add('hidden', 'opacity-0');
        }

        // Panel switch
        if (panelCandidate && panelEmployer) {
          panelCandidate.classList.remove('hidden', 'opacity-0');
          panelCandidate.classList.add('block', 'opacity-100');
          panelEmployer.classList.remove('block', 'opacity-100');
          panelEmployer.classList.add('hidden', 'opacity-0');
        }

        // Secondary CTA switch
        if (secCtaCandidate && secCtaEmployer) {
          secCtaCandidate.classList.remove('hidden', 'opacity-0');
          secCtaCandidate.classList.add('block', 'opacity-100');
          secCtaEmployer.classList.remove('block', 'opacity-100');
          secCtaEmployer.classList.add('hidden', 'opacity-0');
        }

        // Social Proof Strip switch
        if (socialCandidate && socialEmployer) {
          socialCandidate.classList.remove('hidden', 'opacity-0');
          socialCandidate.classList.add('block', 'opacity-100');
          socialEmployer.classList.remove('block', 'opacity-100');
          socialEmployer.classList.add('hidden', 'opacity-0');
        }

        // Integrated Stats Bar switch
        if (statsCandidate && statsEmployer) {
          statsCandidate.classList.remove('hidden', 'opacity-0');
          statsCandidate.classList.add('block', 'opacity-100');
          statsEmployer.classList.remove('block', 'opacity-100');
          statsEmployer.classList.add('hidden', 'opacity-0');
          runCounters(statsCandidate);
        }

        if (cardStatusBadge) cardStatusBadge.textContent = "Candidate Mode";
        if (primaryCtaLabel) primaryCtaLabel.textContent = "Elevate My Career";
      });

      btnEmployer.addEventListener('click', () => {
        btnEmployer.className = "px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-300 flex items-center gap-2 bg-[#041B3B] text-white shadow-md cursor-pointer";
        btnCandidate.className = "px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-300 flex items-center gap-2 text-slate-600 hover:text-[#041B3B] cursor-pointer";

        // Text switch
        if (textCandidate && textEmployer) {
          textEmployer.classList.remove('hidden', 'opacity-0');
          textEmployer.classList.add('block', 'opacity-100');
          textCandidate.classList.remove('block', 'opacity-100');
          textCandidate.classList.add('hidden', 'opacity-0');
        }

        // Panel switch
        if (panelCandidate && panelEmployer) {
          panelEmployer.classList.remove('hidden', 'opacity-0');
          panelEmployer.classList.add('block', 'opacity-100');
          panelCandidate.classList.remove('block', 'opacity-100');
          panelCandidate.classList.add('hidden', 'opacity-0');
        }

        // Secondary CTA switch
        if (secCtaCandidate && secCtaEmployer) {
          secCtaEmployer.classList.remove('hidden', 'opacity-0');
          secCtaEmployer.classList.add('block', 'opacity-100');
          secCtaCandidate.classList.remove('block', 'opacity-100');
          secCtaCandidate.classList.add('hidden', 'opacity-0');
        }

        // Social Proof Strip switch
        if (socialCandidate && socialEmployer) {
          socialEmployer.classList.remove('hidden', 'opacity-0');
          socialEmployer.classList.add('block', 'opacity-100');
          socialCandidate.classList.remove('block', 'opacity-100');
          socialCandidate.classList.add('hidden', 'opacity-0');
        }

        // Integrated Stats Bar switch
        if (statsCandidate && statsEmployer) {
          statsEmployer.classList.remove('hidden', 'opacity-0');
          statsEmployer.classList.add('block', 'opacity-100');
          statsCandidate.classList.remove('block', 'opacity-100');
          statsCandidate.classList.add('hidden', 'opacity-0');
          runCounters(statsEmployer);
        }

        if (cardStatusBadge) cardStatusBadge.textContent = "Employer SLA Mode";
        if (primaryCtaLabel) primaryCtaLabel.textContent = "Schedule Hiring Call";
      });
    }

    // Subtle 3D Card Hover Perspective Effect on Desktop
    const heroCard = document.getElementById('hero-interactive-card');
    if (heroCard && window.innerWidth > 768) {
      heroCard.addEventListener('mousemove', (e) => {
        const rect = heroCard.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = (y - centerY) / 35;
        const rotateY = (centerX - x) / 35;
        heroCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      });

      heroCard.addEventListener('mouseleave', () => {
        heroCard.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;
      });
    }

    // Initial Count Up Trigger
    if (statsCandidate) runCounters(statsCandidate);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeroInteractivity);
  } else {
    setupHeroInteractivity();
  }
</script>
