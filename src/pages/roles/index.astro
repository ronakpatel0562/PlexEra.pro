---

<Layout 
  title="IT & Non-IT Roles Taxonomy | PlexEra Talent Solutions"
  description="Explore top technology and Non-IT industry roles placed by PlexEra across engineering, healthcare, supply chain, manufacturing, and business leadership."
>
  <!-- Header -->
  <section class="py-16 text-center max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-white to-[#f8fafc]">
    <span class="text-xs font-extrabold uppercase tracking-widest text-[#0284c7]">CROSS-INDUSTRY TAXONOMY</span>
    <h1 class="text-4xl sm:text-6xl font-extrabold text-[#041B3B] mt-2">Specialized IT & Non-IT Talent Hub</h1>
    <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto mt-4 font-medium">
      Explore dedicated placement pathways across software, cloud, manufacturing, healthcare, supply chain, and engineering.
    </p>
  </section>

  <!-- IT SECTOR SECTION -->
  <section id="it" class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="flex items-center gap-4 pb-4 border-b border-sky-100">
      <span class="px-4 py-1.5 rounded-full bg-sky-100 text-[#0284c7] font-extrabold text-xs uppercase tracking-wider">IT SECTOR</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#041B3B]">Technology & Digital Innovation Roles</h2>
    </div>

    {itSectorData.map((cat) => {
      const Icon = cat.icon;
      return (
        <div class="space-y-6">
          <div class="flex items-center gap-3">
            <div class="p-3 rounded-2xl bg-sky-100/60 text-[#0284c7] border border-sky-200">
              <Icon class="w-6 h-6" />
            </div>
            <h3 class="text-2xl font-extrabold text-[#041B3B]">{cat.category}</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {cat.roles.map((role) => (
              <a 
                href={`/roles/${role.slug}`}
                class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs hover:shadow-md hover:border-sky-300 transition-all duration-300 flex flex-col justify-between group"
              >
                <div>
                  <h4 class="font-bold text-lg text-[#041B3B] group-hover:text-[#0284c7] transition-colors">{role.name}</h4>
                  <p class="text-xs text-slate-600 mt-2 leading-relaxed">{role.desc}</p>
                </div>

                <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-[#041B3B] group-hover:text-[#0284c7]">
                  <span>View Role Profile</span>
                  <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                </div>
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </section>

  <!-- NON-IT SECTOR SECTION -->
  <section id="non-it" class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 mb-20">
    <div class="flex items-center gap-4 pb-4 border-b border-amber-100">
      <span class="px-4 py-1.5 rounded-full bg-amber-100 text-amber-700 font-extrabold text-xs uppercase tracking-wider">NON-IT SECTOR</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#041B3B]">Core Engineering & Industry Roles</h2>
    </div>

    {nonItSectorData.map((cat) => {
      const Icon = cat.icon;
      return (
        <div class="space-y-6">
          <div class="flex items-center gap-3">
            <div class="p-3 rounded-2xl bg-amber-100/60 text-amber-700 border border-amber-200">
              <Icon class="w-6 h-6" />
            </div>
            <h3 class="text-2xl font-extrabold text-[#041B3B]">{cat.category}</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {cat.roles.map((role) => (
              <a 
                href={`/roles/${role.slug}`}
                class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs hover:shadow-md hover:border-amber-300 transition-all duration-300 flex flex-col justify-between group"
              >
                <div>
                  <h4 class="font-bold text-lg text-[#041B3B] group-hover:text-amber-700 transition-colors">{role.name}</h4>
                  <p class="text-xs text-slate-600 mt-2 leading-relaxed">{role.desc}</p>
                </div>

                <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-[#041B3B] group-hover:text-amber-700">
                  <span>View Role Profile</span>
                  <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                </div>
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </section>
</Layout>
