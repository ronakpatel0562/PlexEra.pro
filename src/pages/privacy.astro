---
import Layout from '../layouts/Layout.astro';
import { 
  ShieldCheck, 
  Lock, 
  EyeOff, 
  FileText, 
  CheckCircle2, 
  Mail, 
  MapPin, 
  Phone, 
  ArrowRight, 
  Sparkles,
  Server,
  UserCheck
} from 'lucide-astro';

const privacyHighlights = [
  {
    icon: EyeOff,
    title: "Zero Data Monetization",
    desc: "We never sell, rent, or trade your resumes, contact details, or corporate hiring requisitions to third-party data brokers or advertising networks."
  },
  {
    icon: UserCheck,
    title: "Explicit Candidate Consent",
    desc: "Candidate profiles and resumes are shared with prospective employers strictly after obtaining explicit, documented approval from the candidate."
  },
  {
    icon: Lock,
    title: "256-Bit Data Encryption",
    desc: "All career materials, form inputs, and communication payloads are encrypted in transit via TLS 1.3 and at rest with AES-256 protocols."
  },
  {
    icon: ShieldCheck,
    title: "Full Rights & Erasure",
    desc: "Exercise your right to access, rectify, port, or permanently delete your career records at any time under GDPR, CCPA, and CPRA regulations."
  }
];

const quickSections = [
  { id: "scope", label: "1. Scope & Commitment" },
  { id: "collection", label: "2. Information We Collect" },
  { id: "usage", label: "3. How We Use Data" },
  { id: "sharing", label: "4. Sharing & Disclosure" },
  { id: "retention", label: "5. Retention & Security" },
  { id: "rights", label: "6. Your Privacy Rights" },
  { id: "contact", label: "7. Contact & Inquiries" }
];
---

<Layout 
  title="Privacy Policy | PlexEra — Candidate Privacy & Data Governance"
  description="Review PlexEra LLC's Privacy Policy. Learn how we safeguard candidate resumes, personal information, and enterprise staffing data with bank-grade confidentiality."
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-20 relative overflow-hidden bg-gradient-to-b from-white via-slate-50/50 to-slate-100/60 dark:from-[#09090b] dark:via-[#09090b] dark:to-[#0f172a]/40 border-b border-slate-200 dark:border-white/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Breadcrumb -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#20C5CA]/10 dark:bg-[#20C5CA]/15 border border-[#20C5CA]/30 text-[#041B3B] dark:text-[#20C5CA] text-xs font-bold mb-6">
        <ShieldCheck class="w-4 h-4 text-[#19A4A8] dark:text-[#20C5CA]" />
        <span>DATA GOVERNANCE & PRIVACY ASSURANCE</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-[#041B3B] dark:text-white tracking-tight">
        Privacy <span class="bg-gradient-to-r from-[#0284c7] via-[#19A4A8] to-[#20C5CA] bg-clip-text text-transparent">Policy</span>
      </h1>

      <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed font-medium">
        At PlexEra LLC (<em>"Where Potential Belongs"</em>), safeguarding the confidentiality and trust of technical candidates and enterprise hiring partners is our highest priority.
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-slate-500 dark:text-slate-400">
        <span class="px-3 py-1 rounded-full bg-slate-200/60 dark:bg-white/10">Effective Date: September 2026</span>
        <span class="px-3 py-1 rounded-full bg-slate-200/60 dark:bg-white/10">Version: 2.4 (Enterprise Standard)</span>
        <span class="px-3 py-1 rounded-full bg-slate-200/60 dark:bg-white/10">Applies to: Candidates, Clients & Site Visitors</span>
      </div>
    </div>
  </section>

  <!-- Core Privacy Guarantees Grid -->
  <section class="py-12 bg-white dark:bg-[#0c0d12] border-b border-slate-200 dark:border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#19A4A8] dark:text-[#20C5CA]">OUR COMMITMENT</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#041B3B] dark:text-white mt-1">Foundational Privacy Guarantees</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {privacyHighlights.map((item) => {
          const Icon = item.icon;
          return (
            <div class="p-6 rounded-2xl bg-slate-50 dark:bg-[#121215] border border-slate-200 dark:border-white/10 shadow-xs hover:border-[#20C5CA]/40 transition-colors">
              <div class="p-3 rounded-xl bg-[#20C5CA]/15 text-[#041B3B] dark:text-[#20C5CA] w-fit mb-4">
                <Icon class="w-5 h-5" />
              </div>
              <h3 class="font-bold text-sm sm:text-base text-[#041B3B] dark:text-white mb-2">{item.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">{item.desc}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Main Legal Document Body -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Quick Navigation Sidebar -->
      <aside class="hidden lg:block lg:col-span-4 sticky top-28 space-y-4">
        <div class="p-5 rounded-2xl bg-white dark:bg-[#121215] border border-slate-200 dark:border-white/10 shadow-sm">
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-400 mb-3">
            Document Contents
          </h3>
          <nav class="space-y-1 text-xs">
            {quickSections.map((sec) => (
              <a 
                href={`#${sec.id}`} 
                class="block px-3 py-2 rounded-lg text-slate-600 dark:text-slate-300 hover:text-[#041B3B] dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 font-semibold transition-colors"
              >
                {sec.label}
              </a>
            ))}
          </nav>

          <div class="mt-6 pt-5 border-t border-slate-100 dark:border-white/10 text-xs space-y-2">
            <span class="font-bold text-[#041B3B] dark:text-white block">Need privacy assistance?</span>
            <p class="text-slate-500 dark:text-slate-400 leading-relaxed">
              Reach our Data Privacy Officer directly for inquiries or removal requests.
            </p>
            <a 
              href="mailto:contact@plexera.pro" 
              class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0284c7] dark:text-[#20C5CA] hover:underline pt-1"
            >
              <span>contact@plexera.pro</span>
              <ArrowRight class="w-3 h-3" />
            </a>
          </div>
        </div>
      </aside>

      <!-- Legal Content Clauses -->
      <div class="lg:col-span-8 space-y-10 text-slate-700 dark:text-slate-300 text-sm leading-relaxed">
        
        <!-- Clause 1 -->
        <article id="scope" class="scroll-mt-32 p-7 sm:p-9 rounded-3xl bg-white dark:bg-[#121215] border border-slate-200 dark:border-white/10 shadow-sm">
          <h2 class="text-xl sm:text-2xl font-bold text-[#041B3B] dark:text-white mb-4">
            1. Scope & Organizational Commitment
          </h2>
          <p class="mb-4">
            This Privacy Policy governs the collection, processing, storage, and protection of personal and corporate data collected by <strong>PlexEra LLC</strong> ("PlexEra," "we," "our," or "us"), a global technology staffing, career acceleration, and talent consulting firm headquartered in Kingsville, Texas, USA.
          </p>
          <p class="mb-4">
            This policy applies to all interactions with our website (<a href="https://plexera.pro" class="text-[#0284c7] dark:text-[#20C5CA] underline font-medium">https://plexera.pro</a>), candidate application dropzones, 1-on-1 consultation booking modals, resume revamp services, technical mock interview sessions, employer staffing inquiries, and post-placement Year-1 support programs.
          </p>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-white/5 border-l-4 border-[#20C5CA] text-xs text-slate-600 dark:text-slate-300">
            <strong>Key Note:</strong> We operate strictly on a skill-alignment and outcome-driven model. We will never monetize your career data, distribute unsolicited resumes, or bypass your authorization when connecting with enterprise clients.
          </div>
        </article>

        <!-- Clause 2 -->
        <article id="collection" class="scroll-mt-32 p-7 sm:p-9 rounded-3xl bg-white dark:bg-[#121215] border border-slate-200 dark:border-white/10 shadow-sm">
          <h2 class="text-xl sm:text-2xl font-bold text-[#041B3B] dark:text-white mb-4">
            2. Information We Collect
          </h2>
          <p class="mb-4">
            We collect only the information necessary to provide precision career elevation and enterprise technical staffing services:
          </p>

          <h3 class="font-bold text-base text-[#041B3B] dark:text-white mt-5 mb-2">A. Candidate Information</h3>
          <ul class="list-disc pl-5 space-y-2 mb-4 text-xs sm:text-sm">
            <li><strong>Contact Details:</strong> Full name, personal email address, phone number, and geographic location.</li>
            <li><strong>Professional Background:</strong> Resume/CV files (.pdf, .docx), portfolio links, GitHub repositories, and LinkedIn profile URLs.</li>
            <li><strong>Career Metrics & Experience:</strong> Target roles, primary tech stack (e.g., React, Go, AWS, DevOps, PLC Automation), total years of experience, and current employment status.</li>
            <li><strong>Compensation & Work Authorization:</strong> Desired compensation brackets, visa sponsorship requirements (US Citizen, Green Card, H-1B, TN, C2C), and availability timelines.</li>
            <li><strong>Coaching Notes:</strong> Technical evaluations and feedback generated during our 1-on-1 mock coaching labs with Google and AWS tech leads.</li>
          </ul>

          <h3 class="font-bold text-base text-[#041B3B] dark:text-white mt-5 mb-2">B. Employer & Enterprise Client Information</h3>
          <ul class="list-disc pl-5 space-y-2 mb-4 text-xs sm:text-sm">
            <li><strong>Organization Details:</strong> Company name, work email, corporate phone, and industry sector.</li>
            <li><strong>Requisition Specifications:</strong> Technical job descriptions, required engineering milestones, tech stack blueprints, and team pod sizing.</li>
            <li><strong>Engagement Preferences:</strong> Desired engagement model (Contract Augmentation, Direct Hire, RPO) and target placement urgency.</li>
          </ul>

          <h3 class="font-bold text-base text-[#041B3B] dark:text-white mt-5 mb-2">C. Automatically Collected Technical Data</h3>
          <p class="text-xs sm:text-sm">
            When browsing our portal, we automatically collect basic browser metadata, IP address, referral sources, and session duration to ensure responsive layout delivery, dark mode preferences, and secure DDoS prevention.
          </p>
        </article>

        <!-- Clause 3 -->
        <article id="usage" class="scroll-mt-32 p-7 sm:p-9 rounded-3xl bg-white dark:bg-[#121215] border border-slate-200 dark:border-white/10 shadow-sm">
          <h2 class="text-xl sm:text-2xl font-bold text-[#041B3B] dark:text-white mb-4">
            3. How We Process & Utilize Your Data
          </h2>
          <p class="mb-4">
            Your data is strictly processed to fulfill the services requested by you:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
            <div class="p-4 rounded-xl border border-slate-100 dark:border-white/8 bg-slate-50/70 dark:bg-white/5">
              <h4 class="font-bold text-[#041B3B] dark:text-white text-xs uppercase tracking-wider mb-1">For Candidates</h4>
              <p class="text-xs text-slate-600 dark:text-slate-300">
                Optimizing resumes for ATS parsers, conducting mock technical interviews, tailoring applications, and advocating for compensation packages during offer negotiation.
              </p>
            </div>
            <div class="p-4 rounded-xl border border-slate-100 dark:border-white/8 bg-slate-50/70 dark:bg-white/5">
              <h4 class="font-bold text-[#041B3B] dark:text-white text-xs uppercase tracking-wider mb-1">For Employers</h4>
              <p class="text-xs text-slate-600 dark:text-slate-300">
                Matching verified, pre-screened technical talent against architecture needs, coordinating interview schedules, and delivering talent in 48 hours.
              </p>
            </div>
          </div>
          <p class="text-xs sm:text-sm mt-3">
            Direct communications regarding advisory slots and talent requisitions are routed securely via our centralized inbox at <a href="mailto:contact@plexera.pro" class="text-[#0284c7] dark:text-[#20C5CA] font-semibold underline">contact@plexera.pro</a>.
          </p>
        </article>

        <!-- Clause 4 -->
        <article id="sharing" class="scroll-mt-32 p-7 sm:p-9 rounded-3xl bg-white dark:bg-[#121215] border border-slate-200 dark:border-white/10 shadow-sm">
          <h2 class="text-xl sm:text-2xl font-bold text-[#041B3B] dark:text-white mb-4">
            4. Data Sharing & Third-Party Disclosure Policy
          </h2>
          <p class="mb-4">
            PlexEra enforces strict non-disclosure and privacy covenants:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm">
            <li><strong>Prospective Hiring Clients:</strong> Candidate career materials (resumes, interview summaries) are presented to prospective employer clients <em>only after</em> the candidate has confirmed interest in the role and authorized the submission.</li>
            <li><strong>Service Infrastructure Providers:</strong> We utilize trusted, enterprise-grade cloud service providers (AWS, Google Workspace, FormSubmit) bound by strict Data Processing Agreements (DPAs) for secure transmission and encrypted storage.</li>
            <li><strong>Legal & Regulatory Mandates:</strong> We may disclose records if required by applicable federal or state laws, valid court orders, or subpoenas.</li>
            <li><strong>No Unrelated Third Parties:</strong> We never disclose, sell, or rent your personal information to advertising networks, telemetry brokers, or unauthorized recruiters.</li>
          </ul>
        </article>

        <!-- Clause 5 -->
        <article id="retention" class="scroll-mt-32 p-7 sm:p-9 rounded-3xl bg-white dark:bg-[#121215] border border-slate-200 dark:border-white/10 shadow-sm">
          <h2 class="text-xl sm:text-2xl font-bold text-[#041B3B] dark:text-white mb-4">
            5. Retention & Security Safeguards
          </h2>
          <p class="mb-4">
            We store data only for as long as necessary to fulfill active career roadmaps, staffing contracts, and compliance obligations.
          </p>
          <div class="space-y-3 text-xs sm:text-sm">
            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/8">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
              <span><strong>Encryption in Transit:</strong> 256-bit SSL/TLS 1.3 protocol enforced across all web pages and API submission endpoints.</span>
            </div>
            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/8">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
              <span><strong>Document Sandboxing:</strong> Resumes and attachments are parsed in sandboxed environments with automated malware scanning.</span>
            </div>
            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/8">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
              <span><strong>Role-Based Access Control (RBAC):</strong> Only vetted, authorized PlexEra career strategists and account partners can access candidate documents.</span>
            </div>
          </div>
        </article>

        <!-- Clause 6 -->
        <article id="rights" class="scroll-mt-32 p-7 sm:p-9 rounded-3xl bg-white dark:bg-[#121215] border border-slate-200 dark:border-white/10 shadow-sm">
          <h2 class="text-xl sm:text-2xl font-bold text-[#041B3B] dark:text-white mb-4">
            6. Your Privacy Rights (GDPR, CCPA/CPRA & US State Rights)
          </h2>
          <p class="mb-4">
            Depending on your jurisdiction, you possess unambiguous legal rights over your personal data:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm mb-6">
            <li><strong>Right to Access & Portability:</strong> Request a complete export of the data we hold regarding your candidate profile or client account.</li>
            <li><strong>Right to Rectification:</strong> Update or correct your resume, contact credentials, or employment status at any time.</li>
            <li><strong>Right to Erasure ("Right to Be Forgotten"):</strong> Request the complete and permanent deletion of your resumes and contact data from our active databases.</li>
            <li><strong>Right to Opt-Out:</strong> Withdraw your consent for active candidate representations or advisory communications at any point.</li>
          </ul>
          <p class="text-xs sm:text-sm">
            To exercise any of these rights, email our Data Privacy Officer at <a href="mailto:contact@plexera.pro" class="text-[#0284c7] dark:text-[#20C5CA] font-bold underline">contact@plexera.pro</a> with the subject line <em>"Privacy Rights Request"</em>. We process all requests within 48 business hours with zero penalty or discrimination.
          </p>
        </article>

        <!-- Clause 7 -->
        <article id="contact" class="scroll-mt-32 p-7 sm:p-9 rounded-3xl bg-white dark:bg-[#121215] border border-slate-200 dark:border-white/10 shadow-sm">
          <h2 class="text-xl sm:text-2xl font-bold text-[#041B3B] dark:text-white mb-4">
            7. Contact Our Data Governance Team
          </h2>
          <p class="mb-6">
            If you have questions, concerns, or requests regarding this Privacy Policy or our data handling practices, please contact us via any of our official channels:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/8 space-y-1">
              <Mail class="w-4 h-4 text-[#20C5CA] mb-2" />
              <span class="font-bold text-[#041B3B] dark:text-white block">Email Inquiries</span>
              <a href="mailto:contact@plexera.pro" class="text-[#0284c7] dark:text-[#20C5CA] hover:underline">contact@plexera.pro</a>
            </div>

            <div class="p-4 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/8 space-y-1">
              <Phone class="w-4 h-4 text-[#20C5CA] mb-2" />
              <span class="font-bold text-[#041B3B] dark:text-white block">Phone Support</span>
              <span>+1 (800) 555-PLEX</span>
            </div>

            <div class="p-4 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/8 space-y-1">
              <MapPin class="w-4 h-4 text-[#20C5CA] mb-2" />
              <span class="font-bold text-[#041B3B] dark:text-white block">USA Headquarters</span>
              <span>Kingsville, Texas 78363</span>
            </div>
          </div>
        </article>

      </div>
    </div>
  </section>
</Layout>
