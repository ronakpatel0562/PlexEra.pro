---
import Layout from '../layouts/Layout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { Sparkles, Phone, Mail, MapPin, Calendar, Clock } from 'lucide-astro';
---

<Layout 
  title="Book a Free Advisory Session | PlexEra Contact"
  description="Schedule a 1-on-1 career or staffing consultation with PlexEra senior strategists. USA & Global contact options available."
>
  <section class="py-20 text-center max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-white to-[#f8fafc]">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#20C5CA]/15 border border-[#20C5CA]/30 text-[#041B3B] text-xs font-bold mb-6">
      <Sparkles class="w-4 h-4 text-[#19A4A8]" />
      <span>DIRECT ADVISORY BOOKING</span>
    </div>

    <h1 class="text-4xl sm:text-6xl font-extrabold text-[#041B3B] tracking-tight">
      Let's Connect & <span class="text-[#0284c7]">Accelerate.</span>
    </h1>

    <p class="mt-4 text-slate-600 text-base sm:text-lg max-w-2xl mx-auto font-medium">
      Schedule a 1-on-1 consultation with senior PlexEra talent strategists or reach our global delivery hubs.
    </p>
  </section>

  <!-- Interactive Form & Contact Cards Container -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-3 gap-10 mb-20">
    
    <!-- Contact Info Cards Column -->
    <div class="space-y-6">
      <div class="bg-white rounded-3xl p-7 border border-slate-200 shadow-sm space-y-4">
        <h3 class="font-extrabold text-lg text-[#041B3B] flex items-center gap-2">
          <MapPin class="w-5 h-5 text-[#19A4A8]" />
          <span>USA Headquarters</span>
        </h3>
        <p class="text-xs text-slate-700 font-medium">1201 North Orange St, Suite 700, Wilmington, DE 19801</p>
        <div class="text-xs text-slate-500 font-semibold flex items-center gap-2 pt-2 border-t border-slate-100">
          <Phone class="w-4 h-4 text-[#19A4A8]" />
          <span>+1 (800) 555-PLEX</span>
        </div>
      </div>

      <div class="bg-white rounded-3xl p-7 border border-slate-200 shadow-sm space-y-4">
        <h3 class="font-extrabold text-lg text-[#041B3B] flex items-center gap-2">
          <MapPin class="w-5 h-5 text-[#19A4A8]" />
          <span>India Delivery Center</span>
        </h3>
        <p class="text-xs text-slate-700 font-medium">PlexEra Tech Hub, Hinjewadi Phase 1, Pune, MH 411057</p>
        <div class="text-xs text-slate-500 font-semibold flex items-center gap-2 pt-2 border-t border-slate-100">
          <Mail class="w-4 h-4 text-[#19A4A8]" />
          <span>contact@plexera.com</span>
        </div>
      </div>

      <div class="bg-white rounded-3xl p-7 border border-slate-200 shadow-sm space-y-3">
        <h4 class="font-bold text-sm text-[#041B3B] flex items-center gap-2">
          <Clock class="w-4 h-4 text-slate-400" />
          <span>Global Support Hours</span>
        </h4>
        <p class="text-xs text-slate-600">Monday – Friday: 8:00 AM – 8:00 PM EST</p>
        <p class="text-xs text-slate-600">Weekend Emergency Staffing SLA: Active 24/7</p>
      </div>
    </div>

    <!-- Booking Form Column -->
    <div class="lg:col-span-2 bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-md flex flex-col justify-center">
      <div class="mb-6">
        <h3 class="text-2xl font-extrabold text-[#041B3B]">Schedule 1-on-1 Session</h3>
        <p class="text-xs text-slate-600 mt-1">Select candidate or employer path to get started.</p>
      </div>

      <button 
        onclick="document.getElementById('booking-modal').classList.remove('hidden')"
        class="w-full py-5 px-8 rounded-2xl bg-[#041B3B] hover:bg-[#082854] text-white font-bold text-base flex items-center justify-center gap-3 shadow-lg cursor-pointer transition-all hover:scale-[1.01]"
      >
        <Calendar class="w-5 h-5 text-[#20C5CA]" />
        <span>Open Interactive Calendar & Booking Form →</span>
      </button>
    </div>

  </section>

  <FaqAccordion />
</Layout>
