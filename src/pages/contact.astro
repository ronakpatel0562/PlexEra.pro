---
import Layout from '../layouts/Layout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { Sparkles, Phone, Mail, MapPin, Calendar, Clock, User, Building, Upload, CheckCircle2, Send } from 'lucide-astro';
---

<Layout 
  title="Book a Free Advisory Session | PlexEra Contact"
  description="Schedule a 1-on-1 career or staffing consultation with PlexEra senior strategists. Submissions delivered directly to contact@plexera.pro."
>
  <section class="py-20 text-center max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-white to-[#f8fafc]">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#20C5CA]/15 border border-[#20C5CA]/30 text-[#041B3B] text-xs font-bold mb-6">
      <Sparkles class="w-4 h-4 text-[#19A4A8]" />
      <span>DIRECT ADVISORY BOOKING</span>
    </div>

    <h1 class="text-4xl sm:text-6xl font-extrabold text-[#041B3B] tracking-tight">
      Let's Connect & <span class="text-[#0284c7]">Accelerate.</span>
    </h1>

    <p class="mt-4 text-slate-600 text-base sm:text-lg max-w-2xl mx-auto font-medium">
      Schedule a 1-on-1 consultation with senior PlexEra talent strategists or reach our USA headquarters directly.
    </p>
  </section>

  <!-- Interactive Form & Contact Cards Container -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-3 gap-10 mb-20">
    
    <!-- Contact Info Cards Column -->
    <div class="space-y-6">
      <div class="bg-white rounded-3xl p-7 border border-slate-200 shadow-sm space-y-4">
        <h3 class="font-extrabold text-lg text-[#041B3B] flex items-center gap-2">
          <MapPin class="w-5 h-5 text-[#19A4A8]" />
          <span>USA Headquarters</span>
        </h3>
        <p class="text-xs text-slate-700 font-medium">King Ave, Kingsville, Texas 78363, USA</p>
        <div class="text-xs text-slate-500 font-semibold flex items-center gap-2 pt-2 border-t border-slate-100">
          <Phone class="w-4 h-4 text-[#19A4A8]" />
          <span>+1 (800) 555-PLEX</span>
        </div>
        <div class="text-xs text-slate-500 font-semibold flex items-center gap-2 pt-1">
          <Mail class="w-4 h-4 text-[#19A4A8]" />
          <a href="mailto:contact@plexera.pro" class="hover:text-[#041B3B] transition-colors">contact@plexera.pro</a>
        </div>
      </div>

      <div class="bg-white rounded-3xl p-7 border border-slate-200 shadow-sm space-y-3">
        <h4 class="font-bold text-sm text-[#041B3B] flex items-center gap-2">
          <Clock class="w-4 h-4 text-slate-400" />
          <span>Support Hours</span>
        </h4>
        <p class="text-xs text-slate-600">Monday – Friday: 8:00 AM – 8:00 PM EST</p>
        <p class="text-xs text-slate-600">Weekend Emergency Staffing SLA: Active 24/7</p>
      </div>

      <div class="bg-slate-50 rounded-3xl p-7 border border-slate-200 text-xs text-slate-600 space-y-2.5">
        <div class="font-bold text-[#041B3B] text-sm flex items-center gap-2">
          <Send class="w-4 h-4 text-[#19A4A8]" />
          <span>Direct Inquiries</span>
        </div>
        <p>All inquiries submitted through this portal are dispatched directly to senior partner inboxes at <strong class="text-[#041B3B]">contact@plexera.pro</strong>.</p>
        <div class="pt-2">
          <button 
            onclick="window.openBookingModal && window.openBookingModal('auto')"
            class="text-[#0284c7] hover:underline font-bold inline-flex items-center gap-1 cursor-pointer"
          >
            <span>Prefer pop-up modal? Open here →</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Interactive Embedded Form Column -->
    <div class="lg:col-span-2 bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-md">
      <div class="mb-6">
        <h3 class="text-2xl font-extrabold text-[#041B3B]">Schedule 1-on-1 Consultation</h3>
        <p class="text-xs text-slate-600 mt-1">Select your path below to route your consultation directly to our strategic team.</p>
      </div>

      <!-- Tab Switcher -->
      <div class="flex p-1 bg-slate-100 rounded-2xl border border-slate-200 mb-6">
        <button 
          id="contact-tab-candidate-btn"
          type="button"
          onclick="switchContactTab('candidate')"
          class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 bg-[#041B3B] text-white shadow-md cursor-pointer"
        >
          <User class="w-4 h-4 text-[#20C5CA]" />
          <span>Candidate / Job Seeker</span>
        </button>
        <button 
          id="contact-tab-employer-btn"
          type="button"
          onclick="switchContactTab('employer')"
          class="flex-1 py-2.5 text-xs sm:text-sm font-bold text-slate-600 hover:text-[#041B3B] rounded-xl transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <Building class="w-4 h-4" />
          <span>Employer / Enterprise</span>
        </button>
      </div>

      <!-- Candidate Embedded Form -->
      <form id="contact-form-candidate" class="space-y-4" onsubmit="event.preventDefault(); handleContactFormSubmit(this, 'Candidate');">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Full Name *</label>
            <input type="text" name="fullName" required placeholder="e.g. Alex Mercer" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Email Address *</label>
            <input type="email" name="email" required placeholder="alex@domain.com" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Target Role Specialty *</label>
            <select name="roleCategory" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:border-[#20C5CA] transition-colors">
              <option value="">Select Primary Specialty...</option>
              <option value="Full-Stack / Frontend / Backend">Full-Stack / Frontend / Backend</option>
              <option value="Cloud & DevOps / Site Reliability">Cloud & DevOps / Site Reliability</option>
              <option value="Data Science / AI & ML Engineering">Data Science / AI & ML Engineering</option>
              <option value="Cybersecurity / Security Lead">Cybersecurity / Security Lead</option>
              <option value="Product Manager / Scrum Lead">Product Manager / Scrum Lead</option>
              <option value="Mechanical & Manufacturing Engineering">Mechanical & Manufacturing Engineering</option>
              <option value="Automation & Controls / PLC">Automation & Controls / PLC</option>
              <option value="Supply Chain & Logistics">Supply Chain & Logistics</option>
              <option value="Healthcare & Life Sciences">Healthcare & Life Sciences</option>
              <option value="Civil & Construction Engineering">Civil & Construction Engineering</option>
              <option value="Financial & Business Analysis">Financial & Business Analysis</option>
              <option value="Other High-Impact Role">Other High-Impact Role</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Years of Experience *</label>
            <select name="experience" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:border-[#20C5CA] transition-colors">
              <option value="1 - 3 Years">1 - 3 Years</option>
              <option value="4 - 7 Years (Mid/Senior)">4 - 7 Years (Mid/Senior)</option>
              <option value="8+ Years (Lead / Staff / Director)">8+ Years (Lead / Staff / Director)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Resume / CV (Optional PDF/DOCX)</label>
          <div 
            id="contact-resume-dropzone" 
            onclick="document.getElementById('contact-candidate-resume').click()"
            class="border-2 border-dashed border-slate-200 hover:border-[#20C5CA] rounded-xl p-4 text-center cursor-pointer transition-colors bg-slate-50"
          >
            <input 
              type="file" 
              id="contact-candidate-resume" 
              name="attachment" 
              accept=".pdf,.doc,.docx" 
              class="hidden" 
              onchange="handleContactResumeSelected(this)"
            />
            <Upload class="w-5 h-5 mx-auto text-[#19A4A8] mb-1" />
            <span id="contact-resume-filename" class="text-xs font-semibold text-slate-700 block">Click or drag resume file here to upload</span>
            <span class="text-[10px] text-slate-500">Delivered directly to contact@plexera.pro (up to 10MB)</span>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Specific Career Goals / Questions (Optional)</label>
          <textarea name="candidateGoals" rows="2" placeholder="Tell us about target companies, target salary, or specific interview timelines..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors"></textarea>
        </div>

        <button 
          type="submit" 
          class="w-full py-3.5 px-6 rounded-xl neon-button text-sm font-bold shadow-md cursor-pointer transition-all flex items-center justify-center gap-2"
        >
          <span class="btn-text">Submit Candidate Advisory Request →</span>
          <span class="btn-spinner hidden items-center gap-2">
            <svg class="animate-spin h-4 w-4 text-[#041B3B]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            <span>Mailing to contact@plexera.pro...</span>
          </span>
        </button>
      </form>

      <!-- Employer Embedded Form -->
      <form id="contact-form-employer" class="hidden space-y-4" onsubmit="event.preventDefault(); handleContactFormSubmit(this, 'Employer');">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Work Email *</label>
            <input type="email" name="workEmail" required placeholder="alex@company.com" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Company Name *</label>
            <input type="text" name="companyName" required placeholder="e.g. Acme Corp" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Staffing Service Model *</label>
            <select name="serviceModel" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:border-[#20C5CA] transition-colors">
              <option value="Contract / Sprint Augmentation">Contract / Sprint Augmentation</option>
              <option value="Direct Hire Placement">Direct Hire Placement</option>
              <option value="Full RPO Strategy">Full RPO Strategy</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Est. Team Size Needed *</label>
            <select name="teamSize" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:border-[#20C5CA] transition-colors">
              <option value="1 - 2 Engineers / Specialists">1 - 2 Engineers / Specialists</option>
              <option value="3 - 5 Engineers / Specialists">3 - 5 Engineers / Specialists</option>
              <option value="6+ Pod / Enterprise Scale">6+ Pod / Enterprise Scale</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Key Skillset & Requisition Details *</label>
          <textarea name="requisitionDetails" required rows="3" placeholder="Specify requirements (e.g. Next.js, SolidWorks, PLC Programming) and target hiring timeline..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#20C5CA] transition-colors"></textarea>
        </div>

        <button 
          type="submit" 
          class="w-full py-3.5 px-6 rounded-xl neon-button text-sm font-bold shadow-md cursor-pointer transition-all flex items-center justify-center gap-2"
        >
          <span class="btn-text">Request Talent Strategy Session →</span>
          <span class="btn-spinner hidden items-center gap-2">
            <svg class="animate-spin h-4 w-4 text-[#041B3B]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            <span>Mailing to contact@plexera.pro...</span>
          </span>
        </button>
      </form>

      <!-- Contact Error Alert -->
      <div id="contact-error-box" class="hidden my-4 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-xs text-rose-700 space-y-2">
        <div class="font-bold flex items-center gap-1.5">
          <span>Submission encountered an issue.</span>
        </div>
        <p id="contact-error-text">Unable to complete request. Please verify your connection or reach us directly.</p>
        <div class="pt-1 border-t border-rose-200/60">
          <span>Direct Email: </span>
          <a id="contact-mailto-fallback" href="mailto:contact@plexera.pro" class="font-bold underline text-rose-800 hover:text-rose-950">contact@plexera.pro</a>
        </div>
      </div>

      <!-- Contact Success Alert -->
      <div id="contact-success-box" class="hidden my-4 p-6 text-center space-y-3 bg-teal-50/70 border border-[#20C5CA]/40 rounded-2xl">
        <CheckCircle2 class="w-12 h-12 text-emerald-600 mx-auto" />
        <h4 class="text-xl font-bold text-[#041B3B]">Consultation Request Received!</h4>
        <p class="text-xs text-slate-600">Your details have been mailed to <strong class="text-[#041B3B]">contact@plexera.pro</strong>. A senior PlexEra partner will reach out within 2 business hours to confirm your advisory slot.</p>
      </div>

    </div>

  </section>

  <script is:inline>
    function switchContactTab(tab) {
      const candBtn = document.getElementById('contact-tab-candidate-btn');
      const empBtn = document.getElementById('contact-tab-employer-btn');
      const candForm = document.getElementById('contact-form-candidate');
      const empForm = document.getElementById('contact-form-employer');
      const errBox = document.getElementById('contact-error-box');

      if (errBox) errBox.classList.add('hidden');

      if (tab === 'candidate') {
        if (candBtn) candBtn.className = 'flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 bg-[#041B3B] text-white shadow-md cursor-pointer';
        if (empBtn) empBtn.className = 'flex-1 py-2.5 text-xs sm:text-sm font-bold text-slate-600 hover:text-[#041B3B] rounded-xl transition-all flex items-center justify-center gap-2 cursor-pointer';
        if (candForm) candForm.classList.remove('hidden');
        if (empForm) empForm.classList.add('hidden');
      } else {
        if (empBtn) empBtn.className = 'flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 neon-button shadow-md cursor-pointer';
        if (candBtn) candBtn.className = 'flex-1 py-2.5 text-xs sm:text-sm font-bold text-slate-600 hover:text-[#041B3B] rounded-xl transition-all flex items-center justify-center gap-2 cursor-pointer';
        if (empForm) empForm.classList.remove('hidden');
        if (candForm) candForm.classList.add('hidden');
      }
    }

    window.handleContactResumeSelected = function(input) {
      const filenameSpan = document.getElementById('contact-resume-filename');
      if (input.files && input.files[0]) {
        const file = input.files[0];
        const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
        if (filenameSpan) {
          filenameSpan.textContent = `✓ Selected: ${file.name} (${sizeMb} MB)`;
          filenameSpan.classList.add('text-teal-600', 'font-bold');
        }
      } else if (filenameSpan) {
        filenameSpan.textContent = 'Click or drag resume file here to upload';
        filenameSpan.classList.remove('text-teal-600', 'font-bold');
      }
    };

    // Drag and drop for contact page dropzone
    document.addEventListener('DOMContentLoaded', () => {
      const dropzone = document.getElementById('contact-resume-dropzone');
      const fileInput = document.getElementById('contact-candidate-resume');
      if (dropzone && fileInput) {
        ['dragenter', 'dragover'].forEach(eventName => {
          dropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropzone.classList.add('border-[#20C5CA]', 'bg-teal-50');
          });
        });
        ['dragleave', 'drop'].forEach(eventName => {
          dropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropzone.classList.remove('border-[#20C5CA]', 'bg-teal-50');
          });
        });
        dropzone.addEventListener('drop', (e) => {
          const dt = e.dataTransfer;
          if (dt && dt.files && dt.files.length) {
            fileInput.files = dt.files;
            window.handleContactResumeSelected(fileInput);
          }
        });
      }
    });

    async function handleContactFormSubmit(formEl, type) {
      const submitBtn = formEl.querySelector('button[type="submit"]');
      const btnText = submitBtn ? submitBtn.querySelector('.btn-text') : null;
      const btnSpinner = submitBtn ? submitBtn.querySelector('.btn-spinner') : null;
      const errorBox = document.getElementById('contact-error-box');
      const errorText = document.getElementById('contact-error-text');
      const mailtoFallback = document.getElementById('contact-mailto-fallback');
      const successBox = document.getElementById('contact-success-box');

      if (errorBox) errorBox.classList.add('hidden');

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.classList.add('hidden');
      if (btnSpinner) btnSpinner.classList.remove('hidden');

      const formData = new FormData(formEl);
      const applicantName = formData.get('fullName') || formData.get('companyName') || 'Portal Inquiry';
      const applicantEmail = formData.get('email') || formData.get('workEmail') || '';

      const subject = `[PlexEra Contact Page] ${type} Consultation - ${applicantName}`;
      formData.set('_subject', subject);
      if (applicantEmail) {
        formData.set('_replyto', applicantEmail);
      }
      formData.set('_template', 'table');
      formData.set('_captcha', 'false');
      formData.set('Audience_Type', type);
      formData.set('Source_URL', window.location.href);
      formData.set('Submission_Time', new Date().toLocaleString());

      try {
        const response = await fetch('https://formsubmit.co/ajax/contact@plexera.pro', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (!response.ok) {
          const errJson = await response.json().catch(() => null);
          throw new Error(errJson?.message || `Server responded with status ${response.status}`);
        }

        formEl.reset();
        const filenameSpan = document.getElementById('contact-resume-filename');
        if (filenameSpan) {
          filenameSpan.textContent = 'Click or drag resume file here to upload';
          filenameSpan.classList.remove('text-teal-600', 'font-bold');
        }

        if (successBox) successBox.classList.remove('hidden');
        successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      } catch (err) {
        console.error('Contact Form Submission Error:', err);
        if (errorBox) {
          errorBox.classList.remove('hidden');
          if (errorText) {
            errorText.textContent = `Could not submit online: ${err.message || 'Network error'}. You can email us directly.`;
          }
          if (mailtoFallback) {
            const bodyContent = encodeURIComponent(`Hello PlexEra Team,\n\nI would like to request an advisory consultation.\n\nType: ${type}\nName/Company: ${applicantName}\nEmail: ${applicantEmail}\n\nThank you.`);
            mailtoFallback.href = `mailto:contact@plexera.pro?subject=${encodeURIComponent(subject)}&body=${bodyContent}`;
          }
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.classList.remove('hidden');
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    }
  </script>

  <FaqAccordion />
</Layout>
