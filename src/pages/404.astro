---
import Layout from '../layouts/Layout.astro';
import { 
  Compass, 
  Home, 
  Briefcase, 
  Search, 
  ArrowRight, 
  Sparkles, 
  HelpCircle, 
  Mail, 
  FileText,
  User,
  Building2
} from 'lucide-astro';

const helpfulLinks = [
  {
    icon: User,
    title: "For Tech Candidates",
    desc: "ATS resume revamps, 1-on-1 interview coaching & salary negotiation.",
    href: "/candidates"
  },
  {
    icon: Building2,
    title: "For Enterprise Hiring",
    desc: "Deploy pre-vetted engineers in 48 hours & scale technical teams.",
    href: "/employers"
  },
  {
    icon: Briefcase,
    title: "In-Demand Roles",
    desc: "Explore 23+ high-growth tech & engineering positions.",
    href: "/roles"
  },
  {
    icon: Mail,
    title: "Direct Advisory Desk",
    desc: "Connect directly with our senior talent partners in Kingsville, TX.",
    href: "/contact"
  }
];
---

<Layout 
  title="404: Page Not Found | PlexEra — Where Potential Belongs"
  description="The requested page could not be found. Navigate back to PlexEra to explore tech career acceleration, IT staffing, and in-demand engineering roles."
>
  <section class="min-h-[80vh] flex items-center justify-center py-16 sm:py-24 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <!-- Ambient Background Glows -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-96 sm:w-[600px] h-96 sm:h-[600px] bg-gradient-to-tr from-[#20C5CA]/15 via-[#0284c7]/10 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute bottom-10 right-10 w-72 h-72 bg-[#041B3B]/5 dark:bg-[#20C5CA]/5 rounded-full blur-2xl pointer-events-none -z-10"></div>

    <div class="max-w-4xl mx-auto w-full text-center">
      
      <!-- Status Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-rose-500/10 dark:bg-rose-500/15 border border-rose-500/30 text-rose-700 dark:text-rose-400 text-xs font-bold mb-6 tracking-wide animate-pulse">
        <Compass class="w-4 h-4 text-rose-600 dark:text-rose-400" />
        <span>ERROR 404 — TRAJECTORY NOT FOUND</span>
      </div>

      <!-- Giant 404 Visual Display -->
      <div class="relative my-2 select-none">
        <h1 class="text-7xl sm:text-9xl lg:text-[11rem] font-black tracking-tighter text-[#041B3B]/10 dark:text-white/5 leading-none">
          404
        </h1>
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="text-5xl sm:text-7xl lg:text-8xl font-black bg-gradient-to-r from-[#0284c7] via-[#19A4A8] to-[#20C5CA] bg-clip-text text-transparent drop-shadow-sm">
            404
          </span>
        </div>
      </div>

      <!-- Descriptive Typography -->
      <h2 class="text-2xl sm:text-4xl font-extrabold text-[#041B3B] dark:text-white tracking-tight mt-4">
        This Career Path Seems to Have Moved.
      </h2>

      <p class="mt-4 text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-xl mx-auto leading-relaxed font-medium">
        The link you followed may be outdated, the requisition may have closed, or the page was relocated. Let’s get you back on track to your full potential.
      </p>

      <!-- Primary Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        <a 
          href="/" 
          class="px-6 py-3.5 text-xs sm:text-sm font-bold neon-button rounded-xl flex items-center gap-2 shadow-lg shadow-[#20C5CA]/20 transition-all hover:scale-[1.02] cursor-pointer"
        >
          <Home class="w-4 h-4" />
          <span>Return to Homepage</span>
        </a>

        <a 
          href="/roles" 
          class="px-6 py-3.5 text-xs sm:text-sm font-bold text-[#041B3B] dark:text-white bg-white dark:bg-[#121215] hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-white/10 rounded-xl flex items-center gap-2 shadow-sm transition-all hover:border-[#20C5CA]/40 cursor-pointer"
        >
          <Briefcase class="w-4 h-4 text-[#19A4A8] dark:text-[#20C5CA]" />
          <span>Explore Open Roles</span>
        </a>

        <button 
          onclick="openBookingModal('auto')"
          class="px-6 py-3.5 text-xs sm:text-sm font-bold text-slate-700 dark:text-slate-300 hover:text-[#041B3B] dark:hover:text-white bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 rounded-xl flex items-center gap-2 transition-colors cursor-pointer"
        >
          <Sparkles class="w-4 h-4 text-[#20C5CA]" />
          <span>Book Free Consult</span>
        </button>
      </div>

      <!-- Quick Directory Navigation Grid -->
      <div class="mt-14 pt-12 border-t border-slate-200 dark:border-white/10 text-left">
        <div class="text-center mb-6">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
            Popular Destinations
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {helpfulLinks.map((item) => {
            const Icon = item.icon;
            return (
              <a 
                href={item.href} 
                class="group p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#121215] border border-slate-200 dark:border-white/10 shadow-xs hover:border-[#20C5CA]/50 hover:shadow-md transition-all duration-200 flex flex-col justify-between"
              >
                <div>
                  <div class="p-2.5 rounded-xl bg-[#20C5CA]/15 text-[#041B3B] dark:text-[#20C5CA] w-fit mb-3 group-hover:bg-[#20C5CA] group-hover:text-[#041B3B] transition-colors">
                    <Icon class="w-4 h-4" />
                  </div>
                  <h3 class="font-bold text-sm text-[#041B3B] dark:text-white group-hover:text-[#0284c7] dark:group-hover:text-[#20C5CA] transition-colors">
                    {item.title}
                  </h3>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
                    {item.desc}
                  </p>
                </div>
                <div class="mt-3 flex items-center text-xs font-bold text-[#0284c7] dark:text-[#20C5CA] gap-1 group-hover:translate-x-1 transition-transform">
                  <span>Visit Page</span>
                  <ArrowRight class="w-3.5 h-3.5" />
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Support Footer Note -->
      <p class="mt-10 text-xs text-slate-400 dark:text-slate-500">
        Encountering a recurring broken link? Let us know at <a href="mailto:contact@plexera.pro" class="underline hover:text-[#20C5CA]">contact@plexera.pro</a>.
      </p>

    </div>
  </section>
</Layout>
